# Construction: placing buildings and turning sites into finished structures.

fn build_instantly [site] do
    let guard 0
    let cell {site_claim site 0 0 0 0}
    while ((cell != nil) and (guard < 20000)) do
        world_set_block cell.x cell.y cell.z cell.block
        set cell {site_claim site 0 0 0 0}
        set guard (guard + 1)
    end
end

fn turns_size [info turns] do
    if ((turns % 2) == 0) { return [info.size_x info.size_z] }
    return [info.size_z info.size_x]
end

# Foundations: cut what stands above the base and fill below it, so a building
# sits true on sloped ground (DESIGN 6.1).
fn add_foundation [site x0 z0 size_x size_z y height] do
    for dx in (0..size_x) do
        for dz in (0..size_z) do
            let x (x0 + dx)
            let z (z0 + dz)
            let top {surface_y x z}
            if (top != nil) do
                let h y
                while ((h <= top) and (h < (y + height + 8))) do
                    if ({block_at x h z} != :air) { site_add site x h z :air }
                    set h (h + 1)
                end
            end
            let g {ground_y x z}
            if (g != nil) do
                let h (g + 1)
                while (h < y) do
                    site_add site x h z :loam
                    set h (h + 1)
                end
            end
        end
    end
end

fn can_place [f name x z] do
    let def {BUILDINGS.get name}
    if (def == nil) { return false }
    return ({blueprint_info def.blueprint} != nil)
end

# Ground that's spoken for, as [x0 z0 x1 z1], the far edges just past it. Two sites on one cell
# take turns undoing each other, and a foundation cuts down whatever stands in it.
fn plot_of [b] do
    let x0 (b.x - (b.size_x / 2))
    let z0 (b.z - (b.size_z / 2))
    return [x0 z0 (x0 + b.size_x) (z0 + b.size_z)]
end

# The yard, with its corner posts and the next floor's stairs, which climb out of its near side
fn yard_plot [zone] do
    let top ((zone.levels * 3) - 1)
    return [(zone.x - zone.levels) (zone.z - top) (zone.x + zone.width + 1) (zone.z + zone.depth + 1)]
end

fn add_plots [plots f] do
    if (f.hall != nil) { plots.push {plot_of f.hall} }
    plots.push {yard_plot f.zone}
    for b in f.buildings do
        plots.push {plot_of b}
    end
    for b in f.sites do
        if {b.has :laid} do
            # Saves from before a run noted its cells have none to go by
            let cells {b.get :cells}
            if (cells != nil) do
                for cell in cells do
                    plots.push [cell[0] cell[1] (cell[0] + 1) (cell[1] + 1)]
                end
            end
        else do
            plots.push {plot_of b}
        end
    end
end

fn all_plots [] do
    let plots []
    for f in factions do
        if (f != nil) { add_plots plots f }
    end
    return plots
end

# What the UI can warn about: this side's own, and what it's found of anyone else's
fn plots_seen_by [f] do
    let plots []
    add_plots plots f
    for other in factions do
        if ((other != nil) and (other.id != f.id)) do
            let theirs []
            add_plots theirs other
            for p in theirs do
                if ({vision_state f.id ((p[0] + p[2]) / 2) ((p[1] + p[3]) / 2)} != :unknown) { plots.push p }
            end
        end
    end
    return plots
end

fn overlaps [plots x0 z0 x1 z1] do
    for p in plots do
        if ((x0 < p[2]) and (p[0] < x1) and (z0 < p[3]) and (p[1] < z1)) { return true }
    end
    return false
end

# Start a building at (x, z), its footprint centred there, if the ground's free
fn place_building [f name x z turns] do
    let def {BUILDINGS.get name}
    if (def == nil) { return nil }
    let info {blueprint_info def.blueprint}
    if (info == nil) { return nil }
    let size {turns_size info turns}
    let x0 (x - (size[0] / 2))
    let z0 (z - (size[1] / 2))
    if {overlaps {all_plots} x0 z0 (x0 + size[0]) (z0 + size[1])} { return nil }
    let g {ground_y x z}
    if (g == nil) { return nil }
    let y (g + 1)

    let site {site_create def.blueprint x0 y z0 turns}
    add_foundation site x0 z0 size[0] size[1] y info.size_y
    let b {=name name =site site =x x =y y =z z =size_x size[0] =size_z size[1]
           =complete false =faction f.id}
    f.sites.push b
    log "faction" f.id "started" name "at" x y z
    return b
end

# A stroke of the block tool: a straight run of cells for Hands to work through, around anything
# whose ground it crosses
fn lay_blocks [f block x0 z0 x1 z1] do
    if ({BLOCK_MATERIAL.get block} == nil) { return nil }
    let dx (x1 - x0)
    let dz (z1 - z0)
    if ({abs dx} >= {abs dz}) { set dz 0 } { set dx 0 }
    let cells ({max {abs dx} {abs dz}} + 1)
    if (cells > LAY_MAX_CELLS) { set cells LAY_MAX_CELLS }
    let step_x {clamp dx -1 1}
    let step_z {clamp dz -1 1}

    let site {site_create}
    let plots {all_plots}
    let laid []
    for i in (0..cells) do
        let x (x0 + (i * step_x))
        let z (z0 + (i * step_z))
        let g {ground_y x z}
        if ((g != nil) and (not {overlaps plots x z (x + 1) (z + 1)})) do
            let y (g + 1)
            if {SURFACE_BLOCKS.contains block} { set y g }
            site_add site x y z block
            laid.push [x z]
        end
    end
    queue_laid f site laid
end

fn queue_laid [f site laid] do
    if (laid.length == 0) do
        site_remove site
        return nil
    end
    f.sites.push {=name :laid =site site =x laid[0][0] =y 0 =z laid[0][1] =size_x 0 =size_z 0
                  =complete false =faction f.id =laid true =cells laid}
end

# A run of wall over the cells marked out, each section standing on its own ground. Where it
# crosses a wall already there it's already joined, and to ground_y that wall is ground.
fn lay_fence [f cells] do
    let site {site_create}
    let plots {all_plots}
    let laid []
    for cell in cells do
        let g {ground_y cell[0] cell[1]}
        let free (not {overlaps plots cell[0] cell[1] (cell[0] + 1) (cell[1] + 1)})
        if ((g != nil) and free and (laid.length < LAY_MAX_CELLS) and (not {FENCE_BLOCKS.contains {block_at cell[0] g cell[1]}})) do
            let y (g + 1)
            for block in FENCE_BLOCKS do
                site_add site cell[0] y cell[1] block
                set y (y + 1)
            end
            laid.push cell
        end
    end
    queue_laid f site laid
end

fn finish_building [f b] do
    if {b.has :laid} do
        site_remove b.site
        return nil
    end
    set b.complete true
    let def {BUILDINGS.get b.name}
    if (def != nil) do
        if ({def.has :housing}) { set f.housing (f.housing + def.housing) }
        if {def.has :vision} {
            set b.lookout {vision_source f.id b.x (b.y + def.eye_height) b.z def.vision}
        }
    end
    f.buildings.push b
    log "faction" f.id "finished" b.name
end

# A queued unit waits on a whole Shelter, and half of each of two houses nobody
fn short_of_beds [f] do
    return (({population f} + f.train_queue + f.muster.length) > f.housing)
end

fn gives_beds [b] do
    let def {BUILDINGS.get b.name}
    return ((def != nil) and {def.has :housing})
end

# With units waiting for a bed, Shelters go ahead of everything else. It's the queue itself that
# moves, so that the work panel shows what will really happen. They stay in order among themselves:
# going by which is nearest done has builders swapping between two Shelters that take turns to lead.
fn shelters_first [f] do
    if ((f.sites.length < 2) or (not {short_of_beds f})) { return nil }
    let order []
    for b in f.sites do
        if {gives_beds b} { order.push b }
    end
    for b in f.sites do
        if (not {gives_beds b}) { order.push b }
    end
    set f.sites order
end

# Retire sites that are done, and floors the Quartermaster queued
fn update_sites [f] do
    let i 0
    while (i < f.sites.length) do
        let b f.sites[i]
        let p {site_progress b.site}
        if ((p != nil) and p.complete) do
            finish_building f b
            f.sites.remove i
        else do
            set i (i + 1)
        end
    end
    shelters_first f

    if (f.zone.expanding != nil) do
        let p {site_progress f.zone.expanding}
        if ((p != nil) and p.complete) { zone_finish_floor f.zone }
    end

    tidy_scaffold f
end

# Temporary scaffolding comes down once nothing's being built
fn tidy_scaffold [f] do
    if ((f.sites.length > 0) or (f.zone.expanding != nil)) { return nil }
    if (f.tidy_site != nil) do
        let p {site_progress f.tidy_site}
        if ((p == nil) or p.complete) do
            site_remove f.tidy_site
            set f.tidy_site nil
        end
        return nil
    end
    if (f.scaffold.length == 0) { return nil }

    let site {site_create}
    for p in f.scaffold do
        if ({block_at p[0] p[1] p[2]} == :scaffold) { site_add site p[0] p[1] p[2] :air }
    end
    set f.scaffold []
    set f.tidy_site site
end

# What's still to come, drawn where it will stand
fn publish_ghosts [f] do
    let ids []
    if (f.zone.expanding != nil) { ids.push f.zone.expanding }
    for b in f.sites do
        ids.push b.site
    end
    site_show_ghosts ids =faction f.id
end

# The most urgent thing to build. Floors count: without room the economy stalls.
fn next_site [f] do
    if (f.zone.expanding != nil) { return f.zone.expanding }
    if (f.sites.length > 0) { return f.sites[0].site }
    return f.tidy_site
end
