# Soldiers: fighting, height, and morale (DESIGN 6.2).
#
# Nobody fights to the last pixel. Hurt, outnumbered, or cut off, a unit's morale
# falls until it breaks and runs for home.

fn make_soldier [f id kind] do
    return {=id id =faction f.id =kind kind =stats {UNITS.get kind}
            =state :hold =order nil =order_x 0 =order_y 0 =order_z 0
            =target nil =cooldown 0.0 =morale 1.0 =last_hp nil =moving false
            =chase_x 0 =chase_z 0 =last_pos nil =chase_time 0.0 =ignore nil =ignore_until 0
            =striking 0.0 =post nil =errand nil =hunting nil =hunt_fails 0 =hunt_blind 0.0
            =siege nil =siege_wait 0.0 =fallbacks []
            =wreck nil =wreck_wait 0.0 =wreck_cell nil =wreck_blows 0 =wreck_tries 0
            =dead_ends [] =explore_wait 0.0 =explore_from nil}
end

# From the table, not the copy in s.stats: a save from before there were strikes of each kind has none
fn strike_anim [s] do
    let anim {UNITS.get s.kind}.strike_anim
    if (anim == nil) { return :work }
    return anim
end

fn spawn_soldier [f kind] do
    let at {spawn_point f.x (f.z + 10) 5 f.y}
    let id {ent_spawn kind at =faction f.id}
    let s {make_soldier f id kind}
    set s.last_hp {ent_health id}
    set s.post {ent_pos id}
    f.army.push s
    index_unit id f s
    return s
end

fn order_soldier [s x y z] do
    set s.order :move
    set s.order_x x
    set s.order_y y
    set s.order_z z
    set s.target nil
    set s.moving false
    set s.errand nil
    set s.hunting nil
    set s.siege nil
    set s.wreck nil
    set s.fallbacks []
    # Drop any route in progress, or it arrives and reads as this order being done
    ent_stop s.id
end

# Sent after one enemy, a soldier sticks to it wherever it goes, and walks to where it was last
# seen if it gets away. The order to go there is what's left when the hunt ends.
fn hunt [s id] do
    let at {ent_pos id}
    order_soldier s at[0] at[1] at[2]
    set s.hunting id
    set s.hunt_fails 0
    set s.hunt_blind 0.0
    set s.target id
    set s.ignore nil
    set s.chase_time 0.0
end

# Only soldiers hunt. Anyone else in the selection just goes there.
fn order_attack [f cmd] do
    let quarry {lookup_unit cmd.target}
    let huntable ((quarry != nil) and {hostile f factions[quarry.faction]} and {ent_alive cmd.target} and {vision_can_see_ent f.id cmd.target})
    let others []
    for id in cmd.units do
        let entry {lookup_unit id}
        if ((entry != nil) and (entry.faction == f.id)) do
            let s entry.record
            if (huntable and {s.has :stats} and (s.stats.role != :scout)) do
                set s.waypoints []
                hunt s cmd.target
            else do
                others.push id
            end
        end
    end
    if (others.length > 0) { order_units f {=units others =x cmd.x =y cmd.y =z cmd.z} }
end

# Sight can drop out for a moment, even up close, and that's no reason to lose the trail
fn follow_quarry [s] do
    if (not {ent_alive s.hunting}) do
        set s.hunting nil
    elif {vision_can_see_ent s.faction s.hunting} do
        let at {ent_pos s.hunting}
        set s.order_x at[0]
        set s.order_y at[1]
        set s.order_z at[2]
        set s.target s.hunting
        set s.hunt_blind 0.0
    else do
        set s.hunt_blind (s.hunt_blind + THINK_SECONDS)
        if (s.hunt_blind > HUNT_BLIND_SECONDS) { set s.hunting nil }
    end
end

# A soldier guards the spot it was last sent to. Walking back to it, it's still on guard.
fn keeping_post [s] { return ((s.order == nil) or (s.errand == :back)) }

# Too far from the post to go after. Otherwise one quick unit can lead the guard off it.
fn past_leash [s target_pos] do
    if ((s.post == nil) or (not {keeping_post s})) { return false }
    return ({dist2 s.post[0] s.post[2] target_pos[0] target_pos[2]} > (POST_LEASH * POST_LEASH))
end

fn go_back [s] do
    if (s.post == nil) { return nil }
    let post s.post
    order_soldier s post[0] post[1] post[2]
    set s.errand :back
end

fn dist3 [a b] do
    let dx (a[0] - b[0])
    let dy (a[1] - b[1])
    let dz (a[2] - b[2])
    return {sqrt ((dx * dx) + (dy * dy) + (dz * dz))}
end

# A chase it lost isn't worth running again yet. It's still an enemy, though: in reach, it's hit
# like any other, and all of this wears off.
fn leaves_alone [s pos id] do
    let target_pos {ent_pos id}
    if {past_leash s target_pos} { return (not {in_range s pos target_pos}) }
    # On guard, a soldier lets an enemy come to it. Run out to meet one, a guard strings out and is
    # beaten one at a time by an attack that arrives together.
    if ({keeping_post s} and (s.post != nil)) do
        let near (GUARD_ENGAGE * GUARD_ENGAGE)
        let from_post {dist2 s.post[0] s.post[2] target_pos[0] target_pos[2]}
        let from_self {dist2 pos[0] pos[2] target_pos[0] target_pos[2]}
        if ((from_post > near) and (from_self > near)) { return (not {in_range s pos target_pos}) }
    end
    if (id != s.ignore) { return false }
    if ({game_tick} >= s.ignore_until) do
        set s.ignore nil
        return false
    end
    return (not {in_range s pos target_pos})
end

# The enemy to go for, of those this unit can actually see. Uses the faction's vision, so the AI and
# the player play by the same rules. Of those about as near as the nearest, the most hurt: so a
# group closes on one enemy together, and one that came in as a column doesn't get that for free.
fn nearest_visible [s pos found] do
    let best nil
    let best_health nil
    let reach nil
    for id in found do
        if ((not {leaves_alone s pos id}) and {vision_can_see_ent s.faction id}) do
            let d {dist3 pos {ent_pos id}}
            if (reach == nil) { set reach (d + FOCUS_SLACK) }
            if (d <= reach) do
                let health {health_of id}
                if ((best == nil) or (health < best_health)) do
                    set best id
                    set best_health health
                end
            end
        end
    end
    return best
end

# Soldiers answer to other soldiers first. A unit on the march won't peel off after
# a farmer it can't already reach, or an attack dissolves into chasing workers.
fn find_enemy [s pos radius] do
    let f s.faction
    for kind in [:militia :shortbow] do
        let found {ent_find pos[0] pos[1] pos[2] radius =enemy_of f =type kind =max 8}
        let id {nearest_visible s pos found}
        if (id != nil) { return id }
    end

    let reach radius
    if (s.order == :move) { set reach (s.stats.range + 1.0) }
    return {nearest_visible s pos {ent_find pos[0] pos[1] pos[2] reach =enemy_of f =max 8}}
end

# Whoever just hurt this unit. Bows reach further than a soldier looks, so waiting to spot them
# would mean standing there being shot.
fn struck_by [s pos] do
    if ({ent_since_damage s.id} > STRUCK_SECONDS) { return nil }
    let id {ent_last_attacker s.id}
    if (not {ent_alive id}) { return nil }
    return {nearest_visible s pos [id]}
end

fn in_range [s pos target_pos] do
    let dy (pos[1] - target_pos[1])
    let reach s.stats.range
    if ((s.stats.role == :ranged) and (dy > 0.0)) {
        set reach (reach + (dy / HIGH_GROUND_RANGE_PER_BLOCKS))
    }
    if ({dist3 pos target_pos} > reach) { return false }
    if (s.stats.role == :ranged) {
        # Arrows stop at the first wall, so an archer has to find a clear shot
        return {line_of_sight pos[0] (pos[1] + 1.4) pos[2] target_pos[0] (target_pos[1] + 1.0) target_pos[2]}
    }
    return true
end

fn strike [s pos target_pos] do
    let damage s.stats.damage
    if ((pos[1] - target_pos[1]) >= 2.0) { set damage (damage * HIGH_GROUND_DAMAGE) }

    ent_look_at s.id target_pos[0] target_pos[1] target_pos[2]
    ent_anim s.id {strike_anim s}
    set s.striking STRIKE_SECONDS

    if (s.stats.role == :ranged) do
        projectile_fire pos[0] (pos[1] + 1.4) pos[2] target_pos[0] (target_pos[1] + 1.0) target_pos[2] =speed ARROW_SPEED =damage damage =owner s.id =faction s.faction
    else do
        ent_damage s.target damage s.id
    end
    set s.cooldown s.stats.cooldown
end

fn count_armed [pos radius faction hostile] do
    let total 0
    for kind in [:militia :shortbow] do
        if hostile do
            let found {ent_find pos[0] pos[1] pos[2] radius =enemy_of faction =type kind =max 16}
            set total (total + found.length)
        else do
            # Allies defend it as their own
            for ally in {allies_of factions[faction]} do
                let found {ent_find pos[0] pos[1] pos[2] radius =faction ally.id =type kind =max 16}
                set total (total + found.length)
            end
        end
    end
    return total
end

fn answering [f] do
    let total 0
    for s in f.army do
        if (s.errand == :help) { set total (total + 1) }
    end
    return total
end

fn nearest_free [f pos] do
    let best nil
    let best_d (ALARM_REACH * ALARM_REACH)
    for s in f.army do
        let free ((s.stats.role != :scout) and (s.state != :rout) and {keeping_post s} and (s.target == nil))
        if (free and (s.last_pos != nil)) do
            let d {dist2 s.last_pos[0] s.last_pos[2] pos[0] pos[2]}
            if (d < best_d) do
                set best s
                set best_d d
            end
        end
    end
    return best
end

# Someone's under attack. Free soldiers go, the nearest first and only as many as it takes, so
# that one raider showing itself can't empty the walls. Afterwards they go back to their posts.
fn raise_alarm [f pos] do
    let tick {game_tick}
    let next {f.get :next_alarm}
    if ((next != nil) and (tick < next)) { return nil }
    set f.next_alarm (tick + (ALARM_SECONDS * 30))
    if ((f.commander != nil) and f.commander.passive) { return nil }

    let enemies {count_armed pos ALARM_RADIUS f.id true}
    let wanted ((enemies * ALARM_ANSWER) - {count_armed pos ALARM_RADIUS f.id false} - {answering f})
    while (wanted > 0) do
        let s {nearest_free f pos}
        if (s == nil) { return nil }
        order_soldier s pos[0] pos[1] pos[2]
        set s.errand :help
        set wanted (wanted - 1)
    end
end

# A rival's Keystone in sight of this soldier and within what it would go after anyway
fn keystone_in_sight [s pos] do
    let reach (s.stats.aggro * s.stats.aggro)
    for f in factions do
        if ((f != nil) and {hostile f factions[s.faction]} and (f.keystone != nil)) do
            let k f.keystone
            if (({dist2 pos[0] pos[2] k[0] k[2]} < reach) and (not {past_leash s k}) and {vision_can_see s.faction k[0] k[2]}) {
                return f
            }
        end
    end
    return nil
end

# Once it's seen one, a soldier sticks to it: sight can drop out for a moment
fn keystone_to_break [s pos] do
    if (contest.state != :playing) { return nil }
    if {brigand_unit s} { return nil }
    if (s.siege != nil) do
        let k factions[s.siege].keystone
        if (k != nil) { return k }
        set s.siege nil
    end
    let f {keystone_in_sight s pos}
    if (f == nil) { return nil }
    set s.siege f.id
    set s.siege_wait 0.0
    set s.order nil
    set s.errand nil
    ent_stop s.id
    set s.moving false
    return f.keystone
end

fn swing_at_keystone [s k] do
    if s.moving do
        ent_stop s.id
        set s.moving false
    end
    if (s.cooldown > 0.0) { return nil }
    ent_look_at s.id (k[0] + 0.5) (k[1] + 0.5) (k[2] + 0.5)
    ent_anim s.id {strike_anim s}
    set s.striking STRIKE_SECONDS
    set s.cooldown s.stats.cooldown
end

# A crowd round it can leave no way in, and anyone in the Hall is helping from where they stand
fn walk_to_keystone [s k] do
    if (s.siege_wait > 0.0) do
        set s.siege_wait (s.siege_wait - THINK_SECONDS)
        return nil
    end
    let nav {ent_nav s.id}
    if ((nav == :pending) or (nav == :moving)) { return nil }
    ent_nav_ack s.id
    if ((nav == :arrived) or (nav == :failed)) do
        set s.moving false
        set s.siege_wait KEYSTONE_RETRY_SECONDS
        return nil
    end
    ent_goto s.id (k[0] + 0.5) k[1] (k[2] + 0.5) =range (KEYSTONE_REACH * 0.8) =partial true =max_nodes 6000
    set s.moving true
end

# Soldiers break a Keystone by standing round it unopposed: see tick_capture. This gets them there
# and shows it happening. It's the same for a player's soldiers and a Rival's.
fn break_keystone [s pos] do
    let k {keystone_to_break s pos}
    if (k == nil) { return false }
    let near {dist2 pos[0] pos[2] (k[0] + 0.5) (k[2] + 0.5)}
    if (near <= (KEYSTONE_REACH * KEYSTONE_REACH)) do
        swing_at_keystone s k
    else do
        walk_to_keystone s k
    end
    return true
end

# ---- Breaking buildings -----------------------------------------------------
#
# Hand to hand, a soldier breaks a building a block at a time: one it's sent at, until there's
# none of it left it can reach, or one of the enemy's in sight from its post, until it stops
# working. Bows and Pathfinders can't.

fn can_wreck [s] { return (s.stats.role == :melee) }

fn wreck [s b ordered] do
    set s.wreck {=faction b.faction =site b.site =name b.name =ordered ordered}
    set s.wreck_cell nil
    set s.wreck_blows 0
    set s.wreck_tries 0
end

fn stop_wrecking [s wait] do
    set s.wreck nil
    set s.wreck_cell nil
    set s.wreck_wait wait
    if s.moving do
        ent_stop s.id
        set s.moving false
    end
end

fn building_in_sight [s pos] do
    let best nil
    let best_d (s.stats.aggro * s.stats.aggro)
    for f in factions do
        if ((f != nil) and {hostile f factions[s.faction]}) do
            for b in f.buildings do
                let d {dist2 pos[0] pos[2] b.x b.z}
                if ((d < best_d) and {building_works b} and (not {past_leash s [b.x b.y b.z]}) and {vision_can_see s.faction b.x b.z}) do
                    set best b
                    set best_d d
                end
            end
        end
    end
    return best
end

fn building_to_wreck [s pos] do
    if (s.wreck != nil) do
        let b {find_building s.wreck.faction s.wreck.site}
        if ((b != nil) and (s.wreck.ordered or {building_works b})) { return b }
        stop_wrecking s 0.0
    end
    if (s.wreck_wait > 0.0) do
        set s.wreck_wait (s.wreck_wait - THINK_SECONDS)
        return nil
    end
    let b {building_in_sight s pos}
    if (b != nil) { wreck s b false }
    return b
end

fn wreck_reach [pos cell] do
    return {dist3 [(cell[0] + 0.5) (cell[1] + 0.5) (cell[2] + 0.5)] [pos[0] (pos[1] + 1.4) pos[2]]}
end

# The nearest block of it within a swing of where the soldier stands, chest high first
fn block_in_reach [b pos] do
    let plot {plot_of b}
    let chest {floor (pos[1] + 1.4)}
    let px {floor pos[0]}
    let pz {floor pos[2]}
    let top ((b.y + {building_height b}) - 1)
    let best nil
    let best_d WRECK_REACH
    for x in ({max_int plot[0] (px - 3)}..{min_int plot[2] (px + 4)}) do
        for z in ({max_int plot[1] (pz - 3)}..{min_int plot[3] (pz + 4)}) do
            for y in ({max_int b.y (chest - 3)}..={min_int top (chest + 3)}) do
                if ({block_at x y z} != :air) do
                    let d {wreck_reach pos [x y z]}
                    if (d < best_d) do
                        set best [x y z]
                        set best_d d
                    end
                end
            end
        end
    end
    return best
end

# The nearest of it that can be got at from the ground it stands on. The top of a tower can't.
fn nearest_low_block [b pos] do
    let plot {plot_of b}
    let top ({max_int b.y {floor pos[1]}} + WRECK_HEIGHT)
    let best nil
    let best_d 0.0
    for x in (plot[0]..plot[2]) do
        for z in (plot[1]..plot[3]) do
            for y in (b.y..=top) do
                if ({block_at x y z} != :air) do
                    let d {wreck_reach pos [x y z]}
                    if ((best == nil) or (d < best_d)) do
                        set best [x y z]
                        set best_d d
                    end
                end
            end
        end
    end
    return best
end

fn blows_for [block] do
    let kind {BLOCK_MATERIAL.get block}
    if ((kind == nil) or (not {WRECK_BLOWS.has kind})) { return WRECK_BLOWS_OTHER }
    return {WRECK_BLOWS.get kind}
end

# A walk that ended with nothing in reach counts as a try, and a few of those give it up for now
fn walk_to_wreck [s pos b] do
    let nav {ent_nav s.id}
    if ((nav == :pending) or (nav == :moving)) { return nil }
    if s.moving do
        ent_nav_ack s.id
        set s.moving false
        set s.wreck_tries (s.wreck_tries + 1)
        if (s.wreck_tries >= WRECK_TRIES) { return stop_wrecking s WRECK_RETRY_SECONDS }
    end
    let cell {nearest_low_block b pos}
    if (cell == nil) { return stop_wrecking s WRECK_RETRY_SECONDS }
    ent_goto s.id (cell[0] + 0.5) cell[1] (cell[2] + 0.5) =range (WRECK_REACH * 0.7) =partial true =max_nodes 6000
    set s.moving true
end

fn break_block [s b cell] do
    world_set_block cell[0] cell[1] cell[2] :air
    set s.wreck_cell nil
    set s.wreck_blows 0
    set s.wreck_tries 0
    let owner factions[b.faction]
    if (owner != nil) do
        note_danger owner cell[0] cell[2]
        raise_alarm owner cell
    end
end

fn wreck_building [s pos] do
    if (not {can_wreck s}) { return false }
    let b {building_to_wreck s pos}
    if (b == nil) { return false }
    let cell s.wreck_cell
    if ((cell != nil) and (({block_at cell[0] cell[1] cell[2]} == :air) or ({wreck_reach pos cell} > WRECK_REACH))) { set cell nil }
    if (cell == nil) do
        set cell {block_in_reach b pos}
        set s.wreck_cell cell
        set s.wreck_blows 0
    end
    if (cell == nil) do
        walk_to_wreck s pos b
        return true
    end
    if s.moving do
        ent_stop s.id
        set s.moving false
    end
    if (s.cooldown > 0.0) { return true }
    ent_look_at s.id (cell[0] + 0.5) (cell[1] + 0.5) (cell[2] + 0.5)
    ent_anim s.id {strike_anim s}
    set s.striking STRIKE_SECONDS
    set s.cooldown s.stats.cooldown
    set s.wreck_blows (s.wreck_blows + 1)
    if (s.wreck_blows >= {blows_for {block_at cell[0] cell[1] cell[2]}}) { break_block s b cell }
    return true
end

fn update_morale [s pos] do
    if {hungry s} { set s.morale (s.morale - (MORALE_LOSS_HUNGRY * THINK_SECONDS)) }
    let hp {ent_health s.id}
    if ((s.last_hp != nil) and (hp < s.last_hp)) {
        set s.morale (s.morale - MORALE_LOSS_HIT)
    }
    set s.last_hp hp

    let f factions[s.faction]
    # Only soldiers are a threat. Nobody breaks at the sight of farmers.
    let enemies {count_armed pos 14 s.faction true}
    if (enemies > 0) do
        let friends {count_armed pos 14 s.faction false}
        if (enemies > friends) {
            set s.morale (s.morale - (MORALE_LOSS_OUTNUMBERED * THINK_SECONDS))
        }
    else do
        set s.morale (s.morale + (MORALE_GAIN_RESTING * THINK_SECONDS))
    end

    if ({dist2 pos[0] pos[2] f.x f.z} < 400) {
        set s.morale (s.morale + (MORALE_GAIN_NEAR_HOME * THINK_SECONDS))
    }
    if (s.morale > 1.0) { set s.morale 1.0 }
    if (s.morale < 0.0) { set s.morale 0.0 }
end

fn rout [s] do
    set s.state :rout
    set s.target nil
    set s.hunting nil
    set s.siege nil
    set s.wreck nil
    set s.moving false
    # It takes up a new post where it rallies
    if (s.errand != nil) { set s.order nil }
    set s.errand nil
    set s.post nil
    ent_speed s.id 1.2
    let f factions[s.faction]
    ent_goto s.id f.x f.y (f.z + 10) =range 6.0 =partial true =max_nodes 6000
end

fn think_rout [s pos] do
    let f factions[s.faction]
    if ((s.morale >= RALLY_AT) and ({dist2 pos[0] pos[2] f.x f.z} < 900)) do
        set s.state :hold
        ent_speed s.id 1.0
        ent_stop s.id
        return nil
    end
    let nav {ent_nav s.id}
    if ((nav == :arrived) or (nav == :failed) or (nav == :idle)) do
        ent_nav_ack s.id
        ent_goto s.id f.x f.y (f.z + 10) =range 6.0 =partial true =max_nodes 6000
    end
end

# Stop the chase as well, or that route arrives and reads as an order being done
fn lose_target [s] do
    set s.target nil
    if s.moving do
        ent_stop s.id
        set s.moving false
    end
end

# Searching for a path is the most expensive thing a unit does. Only search again
# when the old route has stopped being useful.
fn chase [s target_pos] do
    let nav {ent_nav s.id}
    if (nav == :pending) { return nil }
    let moved {dist2 s.chase_x s.chase_z target_pos[0] target_pos[2]}
    if ((nav == :moving) and (moved < CHASE_REPATH_DISTANCE_SQ)) { return nil }

    ent_nav_ack s.id
    set s.chase_x target_pos[0]
    set s.chase_z target_pos[2]
    ent_goto s.id target_pos[0] target_pos[1] target_pos[2] =range (s.stats.range * 0.8) =partial (s.hunting != nil) =max_nodes 6000
    set s.moving true
end

# A meal heals a little at a time, and being hit doesn't stop it
fn digest [s] do
    let left {s.get :meal_left}
    if ((left == nil) or (left <= 0.0)) { return nil }
    set s.meal_left (left - THINK_SECONDS)
    heal s.id (MEAL_HEAL * THINK_SECONDS / MEAL_SECONDS)
    set s.last_hp {ent_health s.id}
end

fn think_soldier [s] do
    if (not {ent_alive s.id}) { return nil }
    let pos {ent_pos s.id}
    if (pos == nil) { return nil }

    if (s.cooldown > 0.0) { set s.cooldown (s.cooldown - THINK_SECONDS) }
    digest s
    update_morale s pos

    # A blow is a single swing. Walking only takes over from idle, so it has to end.
    if (s.striking > 0.0) do
        set s.striking (s.striking - THINK_SECONDS)
        if (s.striking <= 0.0) { ent_anim s.id :idle }
    end

    if (s.state == :rout) { return think_rout s pos }
    if (s.morale < ROUT_AT) { return rout s }

    if (s.stats.role == :scout) { return think_scout s pos }

    # At peace, a soldier just goes where it's told
    let commander factions[s.faction].commander
    let at_peace ((commander != nil) and commander.passive)
    if at_peace { set s.target nil }
    if (s.hunting != nil) { follow_quarry s }

    # Keep fighting what's in front of you
    if ((s.target != nil) and (not {ent_alive s.target})) { lose_target s }
    if ((s.target != nil) and (s.hunting == nil) and (not {vision_can_see_ent s.faction s.target})) { lose_target s }

    # On the march it keeps going, but on guard it answers whoever's hitting it
    if ((not at_peace) and {keeping_post s}) do
        let attacker {struck_by s pos}
        if (attacker != nil) do
            raise_alarm factions[s.faction] pos
            if ((s.target == nil) or (not {in_range s pos {ent_pos s.target}})) { set s.target attacker }
        end
    end
    if ((s.target == nil) and (not at_peace)) { set s.target {find_enemy s pos s.stats.aggro} }

    if (s.target != nil) do
        let target_pos {ent_pos s.target}
        if {in_range s pos target_pos} do
            if s.moving do
                ent_stop s.id
                set s.moving false
            end
            set s.chase_time 0.0
            if (s.cooldown <= 0.0) { strike s pos target_pos }
            return nil
        end
        # Struck in passing, and off again. No sooner caught this time than last.
        if (s.target == s.ignore) do
            set s.target nil
            return nil
        end
        if (s.hunting != nil) do
            # No way to it for now. A few goes, then as near as it can get will have to do.
            let nav {ent_nav s.id}
            if (nav == :moving) { set s.hunt_fails 0 }
            if (nav == :failed) { set s.hunt_fails (s.hunt_fails + 1) }
            if (s.hunt_fails > HUNT_TRIES) do
                ent_nav_ack s.id
                set s.hunting nil
                set s.target nil
                set s.moving false
                return nil
            end
            chase s target_pos
            return nil
        end
        set s.chase_time (s.chase_time + THINK_SECONDS)
        if ((s.chase_time > CHASE_GIVE_UP_SECONDS) or {past_leash s target_pos}) do
            # Can't catch it. Let it go for now and get on with the job.
            set s.ignore s.target
            set s.ignore_until ({game_tick} + (CHASE_FORGET_SECONDS * 30))
            set s.target nil
            set s.chase_time 0.0
            ent_stop s.id
            return nil
        end
        chase s target_pos
        return nil
    end

    if ((not at_peace) and {keeping_post s} and {break_keystone s pos}) { return nil }
    if ((not at_peace) and {keeping_post s} and {wreck_building s pos}) { return nil }

    # Nothing to fight: carry out orders
    if (s.order == :move) do
        let nav {ent_nav s.id}
        # Somebody can be standing in the spot, or it can be a tree. As near as that will do.
        let close ({dist2 pos[0] pos[2] s.order_x s.order_z} < (ORDER_GIVE_UP_RANGE * ORDER_GIVE_UP_RANGE))
        let stop_trying (close or (s.errand == :back))
        # Where it was sent can't be got to: the next place the order could mean
        if ((nav == :failed) and (not close)) {
            if {try_fallback s} { return nil }
        }
        if (((nav == :idle) or (nav == :failed)) and (not ((nav == :failed) and stop_trying))) do
            ent_nav_ack s.id
            ent_goto s.id s.order_x s.order_y s.order_z =range ORDER_RANGE =partial true =max_nodes 6000
            set s.moving true
        elif ((nav == :arrived) or (nav == :failed)) do
            ent_nav_ack s.id
            set s.order nil
            set s.moving false
            if ((s.errand == nil) and {next_waypoint s}) { return nil }
            let errand s.errand
            set s.errand nil
            if (errand == :help) do
                go_back s
            elif ((errand != :back) or (not close)) do
                # A new post, or as near as it can get to the old one
                set s.post pos
            end
        end
    elif (s.post == nil) do
        set s.post pos
    elif ({dist2 pos[0] pos[2] s.post[0] s.post[2]} > (ORDER_GIVE_UP_RANGE * ORDER_GIVE_UP_RANGE)) do
        go_back s
    end
end

fn think_scout [s pos] do
    # The commander hands out a Rival's waypoints. The player's Pathfinders see to their own.
    let own_way (factions[s.faction].commander == nil)
    if (s.order == :move) do
        let nav {ent_nav s.id}
        if (nav == :idle) do
            ent_goto s.id s.order_x s.order_y s.order_z =range 6.0 =partial true =max_nodes 6000
        elif ((nav == :arrived) or (nav == :failed)) do
            # Unreachable waypoints are skipped: the commander hands out the next one
            ent_nav_ack s.id
            if own_way { note_dead_end s pos }
            set s.order nil
            if own_way { next_waypoint s }
        end
    end
    if (own_way and (s.order == nil)) { explore s pos }
end

# Off to the nearest ground nobody's seen. It looks when there's a decision to make, not all
# the time, so the search over the map costs little.
fn explore [s pos] do
    if (s.explore_wait > 0.0) do
        set s.explore_wait (s.explore_wait - THINK_SECONDS)
        return nil
    end
    let spot {nearest_unseen s pos}
    if (spot == nil) do
        # A dead end is only one from where it stood: a lake can be walked around from elsewhere
        set s.dead_ends []
        set s.explore_wait EXPLORE_RECHECK_SECONDS
        return nil
    end
    let y {ground_y spot[0] spot[1]}
    if (y == nil) { set y pos[1] }
    order_soldier s spot[0] (y + 1) spot[1]
    set s.explore_from pos
end

# A long way off, a search can stop part of the way there, and the next one goes on from that. It's
# only a dead end if it's near and still hidden, or the way there got nowhere. Try elsewhere first.
fn note_dead_end [s pos] do
    if ({vision_state s.faction s.order_x s.order_z} != :unknown) { return nil }
    let near ({dist2 pos[0] pos[2] s.order_x s.order_z} < EXPLORE_NEAR_SQ)
    let from s.explore_from
    let stuck ((from != nil) and ({dist2 pos[0] pos[2] from[0] from[2]} < EXPLORE_STUCK_SQ))
    if (near or stuck) { s.dead_ends.push [s.order_x s.order_z] }
end

fn nearest_unseen [s pos] do
    let edge ((WORLD_RADIUS * 16) - EXPLORE_MARGIN)
    let across {floor ((edge * 2) / EXPLORE_GRID)}
    let best nil
    let best_dist 0
    for i in (0..=across) do
        let x ((i * EXPLORE_GRID) - edge)
        for j in (0..=across) do
            let z ((j * EXPLORE_GRID) - edge)
            if ({vision_state s.faction x z} == :unknown) do
                let d {dist2 pos[0] pos[2] x z}
                if (((best == nil) or (d < best_dist)) and (not {was_dead_end s x z})) do
                    set best [x z]
                    set best_dist d
                end
            end
        end
    end
    return best
end

fn was_dead_end [s x z] do
    for spot in s.dead_ends do
        if ((spot[0] == x) and (spot[1] == z)) { return true }
    end
    return false
end

# A unit going down shakes those nearby
fn on_soldier_lost [f s] do
    let pos nil
    if (s.last_pos != nil) { set pos s.last_pos }
    if (pos == nil) { return nil }
    for other in f.army do
        # One mustered this tick hasn't been anywhere yet
        if ((other.last_pos != nil) and ({dist2 other.last_pos[0] other.last_pos[2] pos[0] pos[2]} < 144)) {
            set other.morale (other.morale - MORALE_LOSS_ALLY_DOWN)
        }
    end
end

fn tick_army [f tick] do
    let i 0
    while (i < f.army.length) do
        let s f.army[i]
        if {ent_alive s.id} do
            let p {ent_pos s.id}
            if (p != nil) { set s.last_pos p }
            if (((s.id + tick) % THINK_INTERVAL) == 0) { think_soldier s }
            set i (i + 1)
        else do
            on_soldier_lost f s
            f.army.remove i
        end
    end
end

# The first material the yard has too little of for this, or nil
fn short_for [f cost] do
    for kind in KIND_NAMES do
        if ({cost.has kind} and ({stock_of f kind} < {cost.get kind})) { return kind }
    end
    return nil
end

fn can_afford [f cost] { return ({short_for f cost} == nil) }

# Why a queue isn't moving, in the trace: once each time the reason changes
fn note_wait [f key what detail] do
    if ({f.get key} == what) { return nil }
    f.set key what
    if (what != nil) { trace key "side" f.id what detail }
end

fn pay [f cost] do
    for kind in KIND_NAMES do
        if {cost.has kind} { zone_take f.zone kind {cost.get kind} f.x f.z }
    end
end

fn population [f] { return (f.hands.length + f.army.length) }

fn queue_unit [f kind] do
    f.muster.push kind
end

# A command says how many, up to a batch
fn batch_size [cmd] do
    let count {cmd.get :count}
    if (count == nil) { return 1 }
    return {clamp {to_int count} 1 QUEUE_BATCH}
end

fn queue_many [f kind count] do
    for i in (0..count) do
        queue_unit f kind
    end
end

fn update_muster [f] do
    if (f.muster.length == 0) do
        set f.muster_timer TRAIN_SECONDS
        note_wait f :muster_wait nil nil
        return nil
    end
    let kind f.muster[0]
    if ({population f} >= f.housing) { return note_wait f :muster_wait "no_bed" {=unit kind =population {population f} =housing f.housing} }
    set f.muster_timer {max 0.0 (f.muster_timer - 1.0)}
    if (f.muster_timer > 0.0) { return note_wait f :muster_wait "training" {=unit kind =queued f.muster.length} }

    let stats {UNITS.get kind}
    let short {short_for f stats.cost}
    if (short != nil) { return note_wait f :muster_wait "short" {=unit kind =needs short =cost {stats.cost.get short} =yard {stock_of f short}} }
    pay f stats.cost
    f.muster.remove 0
    set f.muster_timer TRAIN_SECONDS
    let s {spawn_soldier f kind}
    trace :muster "side" f.id "spawned" kind "at" {ent_pos s.id} "queued" f.muster.length
    note_wait f :muster_wait nil nil
end
