# Tier 1 AI: a Hand's jobs and needs (DESIGN 4.2).
#
# Each Hand thinks a few times a second; C++ walks them between thinks. A Hand is
# a small state machine: pick a job, go somewhere, spend time there, move on.

fn make_worker [f id] do
    return {=id id =faction f.id =state :idle =job nil =kind nil
            =carry_kind nil =carry_n 0 =timer 0.0 =hunger 1.0
            =target nil =site nil =cell nil =retry 0 =failures 0 =after nil =danger_check 0.0
            =calm_at 0 =load_waits 0
            =build_x 0 =build_y 0 =build_z 0 =scaffolding false =supplying nil
            =place_waits 0}
end

fn worker_pos [w] {ent_pos w.id}

fn go_to [w x y z range next] do
    set w.state :moving
    set w.scaffolding false
    set w.after next
    ent_goto w.id x y z =range range =max_nodes 16000
end

# Walk there if possible. Only when that fails does it pay for the much larger
# search that can route through scaffolding.
fn go_build_near [w x y z next] do
    set w.state :moving
    set w.after next
    set w.build_x x
    set w.build_y y
    set w.build_z z
    set w.scaffolding false
    ent_goto w.id (x + 0.5) y (z + 0.5) =range 2.0 =max_nodes 6000
end

fn try_scaffolding [w] do
    trace :path "hand" w.id "side" w.faction "scaffolding up to" [w.build_x w.build_y w.build_z]
    set w.scaffolding true
    ent_goto w.id (w.build_x + 0.5) w.build_y (w.build_z + 0.5) =range 2.0 =max_nodes 16000 =place true
end

fn wait_for [w seconds next anim] do
    set w.state :working
    set w.timer seconds
    set w.after next
    ent_anim w.id anim
end

fn drop_job [w] do
    if ({factions[w.faction].get :board} != nil) { board_release factions[w.faction].board w.id }
    release_claims w.id
    set w.job nil
    set w.site nil
    set w.cell nil
    set w.target nil
    set w.state :idle
    ent_anim w.id :idle
end

# A failed path means the target can't be reached right now. Hands who retried at
# once would spend the whole search budget on the same dead end, so they wait, for
# longer each time it keeps happening.
fn give_up [w] do
    let c "-"
    if (w.cell != nil) { set c [w.cell.x w.cell.y w.cell.z] }
    trace :path "hand" w.id "side" w.faction "gave up" w.job w.after "cell" c "scaffolding" w.scaffolding "failures" (w.failures + 1)
    drop_job w
    set w.failures (w.failures + 1)
    set w.state :resting
    set w.timer (2.0 + (w.failures * 1.5))
    if (w.timer > 12.0) { set w.timer 12.0 }
end

fn zone_of [w] { return factions[w.faction].zone }

# ---- Choosing work ----------------------------------------------------------

fn stock_of [f kind] {zone_count f.zone kind}

# Gather whatever the settlement is shortest of, weighted by what's being built
fn wanted_kind [f] do
    let timber {stock_of f :timber}
    let stone {stock_of f :stone}
    let food {stock_of f :provisions}
    # Food first when low: nobody builds on an empty stomach
    if (food < FOOD_RESERVE) { return :provisions }
    if (timber <= stone) {
        if (timber <= (food * 1)) { return :timber }
        return :provisions
    }
    if (stone <= food) { return :stone }
    return :provisions
end

# Roughly two thirds of the settlement builds; the rest keep materials coming. With units waiting
# on a bed everyone lends a hand, as long as there's food to go on with: it's 10% sooner for a Shelter.
fn is_builder [w] do
    if ((w.id % 3) != 0) { return true }
    let f factions[w.faction]
    return ((f.sites.length > 0) and {short_of_beds f} and {gives_beds f.sites[0]} and ({stock_of f :provisions} >= FOOD_RESERVE))
end

fn health_of [id] do
    let most {ent_max_health id}
    if ((most == nil) or (most <= 0)) { return 1.0 }
    return ({ent_health id} / most)
end

fn pick_job [w] do
    let f factions[w.faction]
    let hungry (w.hunger < HUNGER_EAT_AT)
    if ((w.hunger < HURT_HUNGER) and ({health_of w.id} < HURT_EATS_AT)) { set hungry true }

    if (hungry and ({stock_of f :provisions} > 0)) do
        start_eat w
        return nil
    end

    if (w.carry_n > 0) do
        start_carry w
        return nil
    end

    let hurt {soldier_to_feed f}
    if ((hurt != nil) and {start_feed w hurt}) { return nil }

    set w.supplying nil

    if ({is_builder w} and {take_task w}) { return nil }

    let move {find_defrag_move f.zone}
    if ((move != nil) and ((w.id % 5) == 0)) do
        start_defrag w move
        return nil
    end

    start_gather w {wanted_kind f}
end

# ---- Gathering --------------------------------------------------------------

fn harvest_info [block] {HARVEST.get block}

# Lowest log of a trunk, so Hands work at the base rather than reaching up
fn is_trunk_base [p] do
    if ({block_at p[0] p[1] p[2]} != :timber_log) { return true }
    return ({block_at p[0] (p[1] - 1) p[2]} != :timber_log)
end

fn start_gather [w kind] do
    let pos {worker_pos w}
    if (pos == nil) { return nil }
    let f factions[w.faction]
    let names {HARVEST_BLOCKS.get kind}
    # The nearest can all be where the raiders are
    let look 24
    if (f.danger.length > 0) { set look 96 }
    let found {find_blocks pos[0] pos[1] pos[2] SEARCH_RADIUS names =max look}

    for p in found do
        if ({is_trunk_base p} and (not {in_danger f p[0] p[2]})) do
            if {claim_block w.faction p[0] p[1] p[2] w.id 1800} do
                set w.job :gather
                set w.kind kind
                set w.target p
                go_to w (p[0] + 0.5) p[1] (p[2] + 0.5) 1.5 :harvest
                return nil
            end
        end
    end

    # Gathering something else would drop what's in hand
    if (w.carry_n > 0) { return start_carry w }

    # Nothing nearby of what we wanted; try the other materials before idling
    set w.retry (w.retry + 1)
    if (w.retry < 3) do
        let next :timber
        if (kind == :timber) { set next :stone }
        if (kind == :stone) { set next :provisions }
        start_gather w next
    else do
        set w.retry 0
        set w.state :resting
        set w.timer 2.0
    end
end

fn gather_speed [w] do
    let f factions[w.faction]
    let pos {worker_pos w}
    for b in f.buildings do
        let def {BUILDINGS.get b.name}
        if ({def.has :gather_bonus} and (def.gather_bonus == w.kind) and {building_works b}) do
            if ({dist2 b.x b.z pos[0] pos[2]} < (GATHER_BONUS_RADIUS * GATHER_BONUS_RADIUS)) {
                return GATHER_BONUS_SPEED
            }
        end
    end
    return 1.0
end

fn begin_harvest [w] do
    let p w.target
    if (p == nil) { return drop_job w }
    let block {block_at p[0] p[1] p[2]}
    let info {harvest_info block}
    if (info == nil) { return drop_job w }
    ent_look_at w.id (p[0] + 0.5) (p[1] + 0.5) (p[2] + 0.5)
    wait_for w (info.seconds * {gather_speed w}) :harvested info.anim
end

# Felling takes a trunk from the top, so nothing is ever left floating
fn fell_log [p] do
    let y p[1]
    while ({block_at p[0] (y + 1) p[2]} == :timber_log) do
        set y (y + 1)
    end
    # Canopy goes with the first cut. A neighbour felled first can have taken the leaf above
    # this trunk, and then it's the cuts that find what's left of the crown.
    if ({block_at p[0] (y + 1) p[2]} == :canopy) { clear_canopy p[0] (y + 1) p[2] }
    world_set_block p[0] y p[2] :air
    prune_around p[0] y p[2]
    return (y > p[1])
end

fn clear_canopy [x y z] do
    for dx in (-3..=3) do
        for dz in (-3..=3) do
            for dy in (-3..=3) do
                if ({block_at (x + dx) (y + dy) (z + dz)} == :canopy) {
                    world_set_block (x + dx) (y + dy) (z + dz) :air
                }
            end
        end
    end
end

fn near_trunk [x y z] do
    for dx in ((0 - LEAF_REACH)..=LEAF_REACH) do
        for dz in ((0 - LEAF_REACH)..=LEAF_REACH) do
            for dy in ((0 - LEAF_REACH)..=LEAF_REACH) do
                if ({block_at (x + dx) (y + dy) (z + dz)} == :timber_log) { return true }
            end
        end
    end
    return false
end

# Whatever takes a trunk can strand its crown. A leaf that loses its last log was within
# LEAF_REACH of that log, so checking around each cut catches every one.
fn prune_canopy [x0 y0 z0 x1 y1 z1] do
    for x in (x0..=x1) do
        for z in (z0..=z1) do
            for y in (y0..=y1) do
                if (({block_at x y z} == :canopy) and (not {near_trunk x y z})) {
                    world_set_block x y z :air
                }
            end
        end
    end
end

fn prune_around [x y z] do
    prune_canopy (x - LEAF_REACH) (y - LEAF_REACH) (z - LEAF_REACH) (x + LEAF_REACH) (y + LEAF_REACH) (z + LEAF_REACH)
end

fn finish_harvest [w] do
    let p w.target
    let block {block_at p[0] p[1] p[2]}
    let info {harvest_info block}
    if (info == nil) { return drop_job w }

    let more false
    if (block == :timber_log) do
        set more {fell_log p}
    elif (block == :berry_bush) do
        world_set_block p[0] p[1] p[2] :berry_bush_bare
        factions[w.faction].regrow.push {=x p[0] =y p[1] =z p[2] =at ({game_tick} + (BUSH_REGROW_SECONDS * 30))}
    else do
        world_set_block p[0] p[1] p[2] :air
    end

    if ((w.carry_kind != info.kind) and (w.carry_n > 0)) { set w.carry_n 0 }
    set w.carry_kind info.kind
    set w.carry_n (w.carry_n + info.units)

    if (more and (w.carry_n < CARRY_CAP)) {
        return begin_harvest w
    }
    release_block w.faction p[0] p[1] p[2] w.id
    set w.target nil

    if (w.carry_n >= CARRY_CAP) {
        return start_carry w
    }
    start_gather w info.kind
end

# ---- Hauling ----------------------------------------------------------------

# Take this load to wherever it's wanted. A site that needs it is nearer than the yard and back.
fn start_carry [w] do
    let f factions[w.faction]
    if ((not {load_for_yard f w}) and {take_task w}) do
        set w.load_waits 0
        return nil
    end
    # A cell comes free every few seconds, which is sooner than the yard and back. The wait is spent
    # beside the site, out of the way of those building it, and on the board, to be given the next.
    if ((w.load_waits < LOAD_WAIT_TRIES) and (not {yard_short_of f w.carry_kind})) do
        let at {queue_spot f w.carry_kind}
        if (at != nil) do
            set w.load_waits (w.load_waits + 1)
            let pos {worker_pos w}
            if ((pos != nil) and ({dist2 at[0] at[2] pos[0] pos[2]} > (QUEUE_NEAR * QUEUE_NEAR))) do
                go_to w (at[0] + 0.5) at[1] (at[2] + 0.5) 1.5 :queued
                return nil
            end
            set w.state :resting
            set w.timer LOAD_WAIT_SECONDS
            board_update f w
            return nil
        end
    end
    set w.load_waits 0
    start_haul w
end

# Whether a site wants this sooner or later
fn needs_later [site kind] do
    let left {site_remaining site}
    for block in left.keys do
        if ({BLOCK_MATERIAL.get block} == kind) { return true }
    end
    return false
end

# Just outside the first site in line that will want this: near, and not on its floor
fn queue_spot [f kind] do
    for b in f.sites do
        if {needs_later b.site kind} do
            let plot {plot_of b}
            return [(plot[0] - 2) b.y (plot[1] - 2)]
        end
    end
    return nil
end

# Training and mustering can only draw on the yard, so the yard keeps back the cost of the next of
# each, ahead of any building, however the queue is ordered. A unit with no bed to go to can wait:
# it may be the site that's building the bed.
fn unit_reserve [f kind] do
    if ({population f} >= f.housing) { return 0 }
    let held 0
    if (f.muster.length > 0) do
        let cost {UNITS.get f.muster[0]}.cost
        if {cost.has kind} { set held (held + {cost.get kind}) }
    end
    if ((f.train_queue > 0) and {HAND_COST.has kind}) { set held (held + {HAND_COST.get kind}) }
    return held
end

# Eating draws on the yard too
fn yard_reserve [f kind] do
    let held {unit_reserve f kind}
    if (kind == :provisions) { set held (held + FOOD_RESERVE) }
    return held
end

fn yard_short_of [f kind] { return ({stock_of f kind} < {yard_reserve f kind}) }

# What the yard is short of goes there first. A load gathered for a site that had none goes to it
# even with food short, or thatch would wait on a full larder, but never ahead of a unit.
fn load_for_yard [f w] do
    if (w.carry_n <= 0) { return false }
    if ((w.supplying != nil) and ({stock_of f w.carry_kind} >= {unit_reserve f w.carry_kind})) { return false }
    return {yard_short_of f w.carry_kind}
end

# What a builder may take from the yard: what's over the reserve
fn yard_spare [f kind] { return ({stock_of f kind} - {yard_reserve f kind}) }

# ---- The task board ---------------------------------------------------------
#
# Who builds what is settled for the whole side at once, by the engine's task board
# (docs/systems/task-board.md there). Its tasks are the cells of each site's layer being built,
# and its agents the builders, who may fetch from the yard, and anyone with a load in hand. The cost
# is the walk, by way of the yard for a Hand with nothing in hand yet. So a Hand at a cell with
# the block gets it ahead of one far off, and nobody waits on a site with another one free.

fn board_of [f] do
    if (({f.get :board} == nil) or (not {board_alive f.board})) do
        set f.board {board_create}
        board_resources f.board BLOCK_MATERIAL
        board_options f.board =stick BOARD_STICK
    end
    return f.board
end

set MATERIALS [:timber :stone :provisions]

# In the order they're queued, the first worth walking furthest for. Not where raiders were just seen.
# A later site gets a material only once there's more of it, in the yard and in hand, than the sites
# ahead need for their layers being built. Spread over every site, the little there is finishes none of them, and a
# half-built Shelter houses nobody.
fn board_site_list [f] do
    let order []
    if (f.zone.expanding != nil) { order.push f.zone.expanding }
    if (f.tidy_site != nil) { order.push f.tidy_site }
    for b in f.sites do
        if (not {in_danger f b.x b.z}) { order.push b.site }
    end
    let out []
    let ahead {map}
    let stock {map}
    for kind in MATERIALS do
        ahead.set kind 0
        stock.set kind {stock_of f kind}
    end
    for w in f.hands do
        if ((w.carry_n > 0) and {stock.has w.carry_kind}) { stock.set w.carry_kind ({stock.get w.carry_kind} + w.carry_n) }
    end
    let i 0
    for site in order do
        let allowed []
        for kind in MATERIALS do
            if (({ahead.get kind} == 0) or ({stock.get kind} > {ahead.get kind})) { allowed.push kind }
        end
        out.push [site (BOARD_SITE_PRIORITY * (order.length - i)) allowed]
        let left {site_remaining site =now true}
        for block in left.keys do
            let kind {BLOCK_MATERIAL.get block}
            if (kind != nil) { ahead.set kind ({ahead.get kind} + {left.get block}) }
        end
        set i (i + 1)
    end
    return out
end

# Out of it when it's off doing something else, or resting after a path it couldn't find
fn board_available [w] do
    if (w.state == :fleeing) { return false }
    if (w.state == :resting) { return ((w.carry_n > 0) and (w.load_waits > 0)) }
    if ((w.job == nil) or (w.job == :build) or (w.job == :haul)) { return ((w.carry_n > 0) or {is_builder w}) }
    return false
end

# Too far into placing its block to change: at it, climbing to it, or nearly there
fn committed_to_cell [w] do
    if ((w.job != :build) or (w.cell == nil)) { return false }
    if (w.state == :working) { return true }
    if (w.after != :place_block) { return false }
    if w.scaffolding { return true }
    let pos {worker_pos w}
    if (pos == nil) { return false }
    return ({dist2 pos[0] pos[2] (w.cell.x + 0.5) (w.cell.z + 0.5)} < (BOARD_NEAR * BOARD_NEAR))
end

fn board_update [f w] do
    let b {board_of f}
    if ((not {board_available w}) or {load_for_yard f w}) do
        board_drop b w.id
        return nil
    end
    let holds nil
    if (w.carry_n > 0) { set holds w.carry_kind }
    # A gatherer brings its load to a cell that needs it, and goes back to gathering. Foundations and
    # the like are the builders' work.
    let builder {is_builder w}
    board_agent b w.id =holds holds =fetches ((w.carry_n == 0) and builder) =only_holds (not builder) =committed {committed_to_cell w}
end

fn solve_board [f] do
    let b {board_of f}
    board_sites b {board_site_list f}
    # Nothing is fetched that the yard is holding for food, or for the next unit with a bed to go to.
    # Builders gather it instead. Queued first or not, a unit waits on nothing but its bed and cost.
    for kind in MATERIALS do
        let slot nil
        if ({yard_spare f kind} > 0) { set slot {find_take_slot f.zone kind f.x f.z} }
        if (slot == nil) { board_sources b kind [] } { board_sources b kind [[(slot.x + 0.5) slot.y (slot.z + 0.5)]] }
    end
    for w in f.hands do
        board_update f w
    end
    set f.board_stats {board_solve b}
    let solves {f.get :board_solves}
    if (solves == nil) { set solves 0 }
    set f.board_solves (solves + 1)
    if ((solves % 20) == 0) { trace :board "side" f.id f.board_stats }
end

# Work from the board, if it has any for this Hand
fn take_task [w] do
    let f factions[w.faction]
    board_update f w
    let b {board_of f}
    let t {board_take b w.id}
    if (t == nil) do
        # A site queued since the last solve isn't on the board yet
        board_sites b {board_site_list f}
        set t {board_take b w.id}
    end
    if (t == nil) { return false }
    begin_task w t
    return true
end

fn same_cell [w t] {
    return ((w.cell != nil) and (t.site == w.site) and (t.x == w.cell.x) and (t.y == w.cell.y) and (t.z == w.cell.z))
}

# A Hand taking its load to the yard, or to wait by a site, is on the board, and goes to the cell the
# board gives it. Otherwise it holds that cell all the way to the yard.
fn answer_board [w] do
    if (w.carry_n <= 0) { return false }
    if ((w.job != :haul) and (w.after != :queued)) { return false }
    let t {board_task {board_of factions[w.faction]} w.id}
    if (t == nil) { return false }
    ent_stop w.id
    set w.load_waits 0
    begin_task w t
    return true
end

# The board gave this Hand's cell to someone better placed, or the cell was built. Whatever it was on
# its way to do goes, for what the board has for it now.
fn lost_task [w] do
    if ((w.job != :build) or (w.cell == nil) or w.scaffolding) { return false }
    if ((w.after != :place_block) and (w.after != :fetched)) { return false }
    let f factions[w.faction]
    let t {board_task {board_of f} w.id}
    if ((t != nil) and {same_cell w t}) { return false }
    ent_stop w.id
    set w.job nil
    set w.site nil
    set w.cell nil
    set w.state :idle
    if (t != nil) { begin_task w t }
    return true
end

fn start_haul [w] do
    let pos {worker_pos w}
    if (pos == nil) { return nil }
    let zone {zone_of w}
    let slot {find_deposit_slot zone w.carry_kind pos[0] pos[2]}
    if (slot == nil) do
        # Yard's full. Ask for a floor, and help build it with what's in hand.
        let f factions[w.faction]
        zone_plan_floor zone
        set w.state :idle
        set w.carry_n 0
        return nil
    end
    set w.job :haul
    go_to w (slot.x + 0.5) slot.y (slot.z + 0.5) 1.5 :deposit
end

fn finish_deposit [w] do
    let pos {worker_pos w}
    if (pos == nil) { return nil }
    let left {zone_deposit {zone_of w} w.carry_kind w.carry_n pos[0] pos[2]}
    set w.carry_n left
    if (left == 0) { set w.carry_kind nil }
    set w.job nil
    set w.state :idle
end

# ---- Eating -----------------------------------------------------------------

fn start_eat [w] do
    let pos {worker_pos w}
    let zone {zone_of w}
    let slot {find_take_slot zone :provisions pos[0] pos[2]}
    if (slot == nil) { return pick_job_no_eat w }
    set w.job :eat
    go_to w (slot.x + 0.5) slot.y (slot.z + 0.5) 1.5 :eat
end

fn pick_job_no_eat [w] do
    set w.hunger HUNGER_EAT_AT
    set w.state :idle
end

fn finish_eat [w] do
    let pos {worker_pos w}
    if ({zone_take {zone_of w} :provisions 1 pos[0] pos[2]} > 0) do
        set w.hunger 1.0
        heal w.id HAND_MEAL_HEAL
    end
    set w.job nil
    set w.state :idle
end

fn heal [id fraction] do
    let most {ent_max_health id}
    if (most == nil) { return nil }
    ent_set_health id {min most ({ent_health id} + (most * fraction))}
end

# ---- Feeding soldiers ---------------------------------------------------------
#
# A soldier can't leave its post to eat, so a Hand brings it a meal. One Hand to a soldier: who's
# bringing it is the soldier's fed_by, which goes stale if that Hand has since done something else.

fn feeding [s] do
    if ((not {s.has :fed_by}) or (s.fed_by == nil)) { return false }
    let entry {lookup_unit s.fed_by}
    return ((entry != nil) and {ent_alive s.fed_by} and (entry.record.job == :feed) and (entry.record.target == s.id))
end

fn soldier_to_feed [f] do
    if ({stock_of f :provisions} <= 0) { return nil }
    for s in f.army do
        let left {s.get :meal_left}
        let eating ((left != nil) and (left > 0.0))
        let at {ent_pos s.id}
        if ({ent_alive s.id} and (at != nil) and (s.state != :rout) and (not eating) and (not {feeding s})) do
            # Not into where raiders were just seen, whatever the soldier's doing there
            if (({health_of s.id} < MEAL_AT) and ({ent_since_damage s.id} > MEAL_CALM_SECONDS) and (s.target == nil) and (not {in_danger f at[0] at[2]})) { return s }
        end
    end
    return nil
end

fn start_feed [w s] do
    let pos {worker_pos w}
    if (pos == nil) { return false }
    let slot {find_take_slot {zone_of w} :provisions pos[0] pos[2]}
    if (slot == nil) { return false }
    set w.job :feed
    set w.target s.id
    set s.fed_by w.id
    go_to w (slot.x + 0.5) slot.y (slot.z + 0.5) 1.5 :fetch_meal
    return true
end

fn finish_fetch_meal [w] do
    let pos {worker_pos w}
    if ({zone_take {zone_of w} :provisions 1 pos[0] pos[2]} == 0) { return drop_job w }
    serve_meal w
end

fn serve_meal [w] do
    let at {ent_pos w.target}
    if ((at == nil) or (not {ent_alive w.target})) { return drop_job w }
    go_to w at[0] at[1] at[2] 1.8 :serve
end

# It may have walked off since. Close enough, it eats; otherwise after it.
fn finish_serve [w] do
    let at {ent_pos w.target}
    let pos {worker_pos w}
    if ((at == nil) or (pos == nil) or (not {ent_alive w.target})) { return drop_job w }
    if ({dist2 at[0] at[2] pos[0] pos[2]} > 9.0) { return serve_meal w }
    let entry {lookup_unit w.target}
    if (entry != nil) do
        set entry.record.meal_left MEAL_SECONDS
        set entry.record.fed_by nil
    end
    set w.job nil
    set w.target nil
    set w.state :idle
end

# ---- Building ---------------------------------------------------------------

# A task from the board: a cell to fill, or to clear
fn begin_task [w t] do
    set w.job :build
    set w.site t.site
    set w.cell {=x t.x =y t.y =z t.z =block t.block}

    let material {BLOCK_MATERIAL.get t.block}
    if ((material == nil) or ((w.carry_kind == material) and (w.carry_n > 0))) do
        go_build_near w t.x t.y t.z :place_block
        return nil
    end

    # Fetch it first. With none in the yard, it gathers some, and the cell goes to whoever has one.
    let b {board_of factions[w.faction]}
    if (w.carry_n > 0) do
        # The board doesn't send a Hand with the wrong load, but a load can change between solves
        board_release b w.id
        set w.job nil
        set w.site nil
        set w.cell nil
        return start_haul w
    end
    let pos {worker_pos w}
    let slot nil
    if ((pos != nil) and ({yard_spare factions[w.faction] material} > 0)) { set slot {find_take_slot {zone_of w} material pos[0] pos[2]} }
    if (slot == nil) do
        board_release b w.id
        set w.job nil
        set w.cell nil
        set w.supplying w.site
        set w.site nil
        return start_gather w material
    end
    # It keeps the task while it fetches, and loses it to anyone better placed with a block in hand
    set w.kind material
    go_to w (slot.x + 0.5) slot.y (slot.z + 0.5) 1.5 :fetched
end

fn finish_fetch [w] do
    let pos {worker_pos w}
    let spare {yard_spare factions[w.faction] w.kind}
    let got 0
    if (spare > 0) { set got {zone_take {zone_of w} w.kind {min CARRY_CAP spare} pos[0] pos[2]} }
    if (got == 0) { return drop_job w }
    set w.carry_kind w.kind
    set w.carry_n got
    # Its cell, if it still has it, or now it has the block, whatever's best
    if {take_task w} { return nil }
    start_carry w
end

fn begin_place [w] do
    let cell w.cell
    ent_look_at w.id (cell.x + 0.5) (cell.y + 0.5) (cell.z + 0.5)
    wait_for w 0.5 :placed :build
end

# Someone's standing where the block goes, who'd be shut inside it. They'll likely move off soon.
fn wait_for_room [w x y z] do
    if ({cell_occupied x y z =except w.id} == nil) do
        set w.place_waits 0
        return false
    end
    let waits {w.get :place_waits}
    if (waits == nil) { set waits 0 }
    set w.place_waits (waits + 1)
    return true
end

fn finish_place [w] do
    let cell w.cell
    # Clearing a cell to air can't shut anyone in
    if ({BLOCK_MATERIAL.get cell.block} != nil) do
        if {wait_for_room w cell.x cell.y cell.z} do
            if (w.place_waits < PLACE_WAIT_TRIES) { return wait_for w 0.3 :placed :build }
            set w.place_waits 0
            let by {cell_occupied cell.x cell.y cell.z =except w.id}
            let what "nobody now"
            if (by != nil) { set what {ent_type by} }
            trace :place "hand" w.id "side" w.faction "gave up on" [cell.x cell.y cell.z] cell.block "in the way" what by
            return drop_job w
        end
    end
    let cut ({block_at cell.x cell.y cell.z} == :timber_log)
    world_set_block cell.x cell.y cell.z cell.block
    if cut { prune_around cell.x cell.y cell.z }
    let material {BLOCK_MATERIAL.get cell.block}
    if (material != nil) do
        set w.carry_n (w.carry_n - 1)
        if (w.carry_n <= 0) do
            set w.carry_n 0
            set w.carry_kind nil
        end
    end
    set w.cell nil
    set w.site nil
    set w.job nil
    board_release {board_of factions[w.faction]} w.id
    # What's left of the load goes on. A gatherer with nothing left goes back for more, or nobody's
    # keeping materials coming.
    if (w.carry_n > 0) { return start_carry w }
    if ({is_builder w} and {take_task w}) { return nil }
    set w.state :idle
end

# ---- Quartermaster defrag ---------------------------------------------------

fn start_defrag [w move] do
    set w.job :defrag
    set w.target move
    let s move.from
    go_to w (s.x + 0.5) s.y (s.z + 0.5) 1.5 :defrag_take
end

fn finish_defrag_take [w] do
    let move w.target
    let s move.from
    if ((s.kind != move.kind) or (s.amount <= 0)) { return drop_job w }
    set w.carry_kind move.kind
    set w.carry_n s.amount
    set s.amount 0
    slot_paint s
    set w.target nil
    start_haul w
end

# ---- Think ------------------------------------------------------------------

fn on_arrive [w] do
    ent_nav_ack w.id
    match w.after
        :harvest { begin_harvest w }
        :deposit { finish_deposit w }
        :eat { finish_eat w }
        :fetched { finish_fetch w }
        :place_block { begin_place w }
        :defrag_take { finish_defrag_take w }
        :fetch_meal { finish_fetch_meal w }
        :serve { finish_serve w }
        :rally { if (not {next_waypoint w}) { set w.state :idle } }
        :queued { set w.state :idle }
        _ { set w.state :idle }
    end
end

fn on_work_done [w] do
    ent_anim w.id :idle
    match w.after
        :harvested { finish_harvest w }
        :placed { finish_place w }
        :scaffolded do
            # Only a route to a block takes scaffolding. Without this, it gets there and forgets why.
            set w.after :place_block
            ent_nav_resume w.id
            set w.state :moving
        end
        _ { set w.state :idle }
    end
end

# A constructive path stopped us at a step that needs a block. Spend one.
fn handle_nav_block [w] do
    let action {ent_nav_action w.id}
    if (action == nil) { return nil }
    if (action.kind == :place) do
        let p action.pos
        if {wait_for_room w p[0] p[1] p[2]} do
            # Still blocked next think, so this is asked again then. Past a while, another way.
            if (w.place_waits >= PLACE_WAIT_TRIES) do
                set w.place_waits 0
                ent_nav_ack w.id
                give_up w
            end
            return nil
        end
        world_set_block p[0] p[1] p[2] :scaffold
        factions[w.faction].scaffold.push p
        set w.state :working
        set w.timer 0.3
        set w.after :scaffolded
    else do
        let p action.pos
        world_set_block p[0] p[1] p[2] :air
        ent_nav_resume w.id
    end
end

# Where raiders were seen, for the whole side to keep clear of. One on the move keeps its mark.
fn note_danger [f x z] do
    let ends ({game_tick} + (DANGER_SECONDS * 30))
    for spot in f.danger do
        if ({dist2 spot.x spot.z x z} < (DANGER_RADIUS * DANGER_RADIUS)) do
            set spot.x x
            set spot.z z
            set spot.ends ends
            return nil
        end
    end
    f.danger.push {=x x =z z =ends ends}
end

fn in_danger [f x z] do
    for spot in f.danger do
        if ({dist2 spot.x spot.z x z} < (DANGER_RADIUS * DANGER_RADIUS)) { return true }
    end
    return false
end

fn forget_danger [f] do
    let tick {game_tick}
    let i 0
    while (i < f.danger.length) do
        if (tick >= f.danger[i].ends) { f.danger.remove i } { set i (i + 1) }
    end
end

# Who's near, or who hurt this Hand: a bow reaches further than it looks
fn threat_to [w pos] do
    let near {ent_find pos[0] pos[1] pos[2] FLEE_RADIUS =enemy_of w.faction =max 1}
    if (near.length > 0) { return near[0] }
    if ({ent_since_damage w.id} <= STRUCK_SECONDS) do
        let id {ent_last_attacker w.id}
        if {ent_alive id} { return id }
    end
    return nil
end

# Hands aren't soldiers. With raiders close they drop everything and run for home, and they don't
# turn back the moment they're clear: what they were doing is still where the raiders are.
fn check_danger [w] do
    set w.danger_check (w.danger_check - THINK_SECONDS)
    if (w.danger_check > 0.0) { return false }
    set w.danger_check FLEE_CHECK_SECONDS

    let pos {worker_pos w}
    if (pos == nil) { return false }
    let threat {threat_to w pos}
    if (threat == nil) do
        if ((w.state == :fleeing) and ({game_tick} >= w.calm_at)) do
            set w.state :idle
            set w.flee_to nil
        end
        return false
    end
    let f factions[w.faction]
    raise_alarm f pos
    let at {ent_pos threat}
    if (at == nil) { set at pos }
    note_danger f at[0] at[2]
    set w.calm_at ({game_tick} + (FLEE_CALM_SECONDS * 30))
    # Away, if where it was running to is where the raiders are now
    let to {w.get :flee_to}
    let unsafe ((to != nil) and ({dist2 at[0] at[2] to[0] to[2]} < (DANGER_RADIUS * DANGER_RADIUS)))
    if ((w.state != :fleeing) or unsafe) do
        drop_job w
        ent_stop w.id
        set w.state :fleeing
        let spot {flee_spot f pos at}
        set w.flee_to spot
        ent_goto w.id spot[0] spot[1] spot[2] =range 3.0 =partial true =max_nodes 6000
        trace :flee "hand" w.id "side" w.faction "from" {ent_type threat} threat "at" {floor at[0]} {floor at[2]} "to" spot[3] {floor spot[0]} {floor spot[2]}
    end
    return true
end

# Home, where the soldiers come, unless the raiders are there or on the way. Then straight away from
# them: the Hall is no place to hide from raiders at the Hall.
fn flee_spot [f pos at] do
    let home [(f.x + 0.5) f.y (f.z + 1.5) "home"]
    let to_home {dist2 at[0] at[2] home[0] home[2]}
    if ((to_home > (DANGER_RADIUS * DANGER_RADIUS)) and (to_home >= {dist2 at[0] at[2] pos[0] pos[2]})) { return home }
    let dx (pos[0] - at[0])
    let dz (pos[2] - at[2])
    let d {sqrt ((dx * dx) + (dz * dz))}
    if (d < 0.5) do
        # On top of it: away from home, which is where it came from
        set dx (pos[0] - home[0])
        set dz (pos[2] - home[2])
        set d {max 0.5 {sqrt ((dx * dx) + (dz * dz))}}
    end
    let x (pos[0] + ((dx / d) * FLEE_DISTANCE))
    let z (pos[2] + ((dz / d) * FLEE_DISTANCE))
    let g {ground_y {floor x} {floor z}}
    let y pos[1]
    if (g != nil) { set y (g + 1) }
    return [x y z "away"]
end

fn think [w] do
    set w.hunger (w.hunger - (THINK_SECONDS / HUNGER_SECONDS))
    if (w.hunger < 0.0) { set w.hunger 0.0 }

    if {check_danger w} { return nil }

    match w.state
        :idle { pick_job w }
        :moving do
            if ({lost_task w} or {answer_board w}) { return nil }
            let nav {ent_nav w.id}
            match nav
                :arrived do
                    set w.failures 0
                    on_arrive w
                end
                :failed do
                    ent_nav_ack w.id
                    if ((w.job == :build) and (w.after == :place_block) and (not w.scaffolding)) do
                        try_scaffolding w
                    elif ((w.after != :rally) or (not {try_fallback w})) do
                        give_up w
                    end
                end
                :blocked { handle_nav_block w }
                :idle {
                    # Order was lost, e.g. a command replaced it
                    drop_job w
                }
                _ { nil }
            end
        end
        :working do
            set w.timer (w.timer - THINK_SECONDS)
            if (w.timer <= 0.0) { on_work_done w }
        end
        :resting do
            set w.timer (w.timer - THINK_SECONDS)
            # Waiting with a load, it goes as soon as the board has a cell for it
            if ((w.carry_n > 0) and (w.load_waits > 0)) do
                let t {board_task {board_of factions[w.faction]} w.id}
                if (t != nil) do
                    set w.load_waits 0
                    return begin_task w t
                end
            end
            if (w.timer <= 0.0) { set w.state :idle }
        end
        _ { nil }
    end
end
