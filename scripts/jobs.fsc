# Tier 1 AI: a Hand's jobs and needs (DESIGN 4.2).
#
# Each Hand thinks a few times a second; C++ walks them between thinks. A Hand is
# a small state machine: pick a job, go somewhere, spend time there, move on.

fn make_worker [f id] do
    return {=id id =faction f.id =state :idle =job nil =kind nil
            =carry_kind nil =carry_n 0 =timer 0.0 =hunger 1.0
            =target nil =site nil =cell nil =retry 0 =failures 0 =after nil =danger_check 0.0
            =calm_at 0 =load_waits 0
            =build_x 0 =build_y 0 =build_z 0 =scaffolding false =supplying nil}
end

fn worker_pos [w] {ent_pos w.id}

fn go_to [w x y z range next] do
    set w.state :moving
    set w.after next
    ent_goto w.id x y z =range range =max_nodes 16000
end

# Walk there if possible. Only when that fails does it pay for the much larger
# search that can route through scaffolding.
fn go_build_near [w x y z next] do
    set w.state :moving
    set w.after next
    set w.build_x x
    set w.build_y y
    set w.build_z z
    set w.scaffolding false
    ent_goto w.id (x + 0.5) y (z + 0.5) =range 2.0 =max_nodes 6000
end

fn try_scaffolding [w] do
    set w.scaffolding true
    ent_goto w.id (w.build_x + 0.5) w.build_y (w.build_z + 0.5) =range 2.0 =max_nodes 16000 =place true
end

fn wait_for [w seconds next] do
    set w.state :working
    set w.timer seconds
    set w.after next
    ent_anim w.id :work
end

fn drop_job [w] do
    if (w.site != nil) { site_release w.site w.id }
    release_claims w.id
    set w.job nil
    set w.site nil
    set w.cell nil
    set w.target nil
    set w.state :idle
    ent_anim w.id :idle
end

# A failed path means the target can't be reached right now. Hands who retried at
# once would spend the whole search budget on the same dead end, so they wait, for
# longer each time it keeps happening.
fn give_up [w] do
    drop_job w
    set w.failures (w.failures + 1)
    set w.state :resting
    set w.timer (2.0 + (w.failures * 1.5))
    if (w.timer > 12.0) { set w.timer 12.0 }
end

fn zone_of [w] { return factions[w.faction].zone }

# ---- Choosing work ----------------------------------------------------------

fn stock_of [f kind] {zone_count f.zone kind}

# Gather whatever the settlement is shortest of, weighted by what's being built
fn wanted_kind [f] do
    let timber {stock_of f :timber}
    let stone {stock_of f :stone}
    let food {stock_of f :provisions}
    # Food first when low: nobody builds on an empty stomach
    if (food < FOOD_RESERVE) { return :provisions }
    if (timber <= stone) {
        if (timber <= (food * 1)) { return :timber }
        return :provisions
    }
    if (stone <= food) { return :stone }
    return :provisions
end

# Roughly two thirds of the settlement builds; the rest keep materials coming. With units waiting
# on a bed everyone lends a hand, as long as there's food to go on with: it's 10% sooner for a Shelter.
fn is_builder [w] do
    if ((w.id % 3) != 0) { return true }
    let f factions[w.faction]
    return ((f.sites.length > 0) and {short_of_beds f} and {gives_beds f.sites[0]} and ({stock_of f :provisions} >= FOOD_RESERVE))
end

fn pick_job [w] do
    let f factions[w.faction]

    if ((w.hunger < HUNGER_EAT_AT) and ({stock_of f :provisions} > 0)) do
        start_eat w
        return nil
    end

    if (w.carry_n > 0) do
        start_carry w
        return nil
    end

    set w.supplying nil

    let site {next_site f}
    if ((site != nil) and {is_builder w}) do
        start_build w site
        return nil
    end

    let move {find_defrag_move f.zone}
    if ((move != nil) and ((w.id % 5) == 0)) do
        start_defrag w move
        return nil
    end

    start_gather w {wanted_kind f}
end

# ---- Gathering --------------------------------------------------------------

fn harvest_info [block] {HARVEST.get block}

# Lowest log of a trunk, so Hands work at the base rather than reaching up
fn is_trunk_base [p] do
    if ({block_at p[0] p[1] p[2]} != :timber_log) { return true }
    return ({block_at p[0] (p[1] - 1) p[2]} != :timber_log)
end

fn start_gather [w kind] do
    let pos {worker_pos w}
    if (pos == nil) { return nil }
    let f factions[w.faction]
    let names {HARVEST_BLOCKS.get kind}
    # The nearest can all be where the raiders are
    let look 24
    if (f.danger.length > 0) { set look 96 }
    let found {find_blocks pos[0] pos[1] pos[2] SEARCH_RADIUS names =max look}

    for p in found do
        if ({is_trunk_base p} and (not {in_danger f p[0] p[2]})) do
            if {claim_block w.faction p[0] p[1] p[2] w.id 1800} do
                set w.job :gather
                set w.kind kind
                set w.target p
                go_to w (p[0] + 0.5) p[1] (p[2] + 0.5) 1.5 :harvest
                return nil
            end
        end
    end

    # Gathering something else would drop what's in hand
    if (w.carry_n > 0) { return start_carry w }

    # Nothing nearby of what we wanted; try the other materials before idling
    set w.retry (w.retry + 1)
    if (w.retry < 3) do
        let next :timber
        if (kind == :timber) { set next :stone }
        if (kind == :stone) { set next :provisions }
        start_gather w next
    else do
        set w.retry 0
        set w.state :resting
        set w.timer 2.0
    end
end

fn gather_speed [w] do
    let f factions[w.faction]
    let pos {worker_pos w}
    for b in f.buildings do
        let def {BUILDINGS.get b.name}
        if ({def.has :gather_bonus} and (def.gather_bonus == w.kind)) do
            if ({dist2 b.x b.z pos[0] pos[2]} < (GATHER_BONUS_RADIUS * GATHER_BONUS_RADIUS)) {
                return GATHER_BONUS_SPEED
            }
        end
    end
    return 1.0
end

fn begin_harvest [w] do
    let p w.target
    if (p == nil) { return drop_job w }
    let block {block_at p[0] p[1] p[2]}
    let info {harvest_info block}
    if (info == nil) { return drop_job w }
    ent_look_at w.id (p[0] + 0.5) (p[1] + 0.5) (p[2] + 0.5)
    wait_for w (info.seconds * {gather_speed w}) :harvested
end

# Felling takes a trunk from the top, so nothing is ever left floating
fn fell_log [p] do
    let y p[1]
    while ({block_at p[0] (y + 1) p[2]} == :timber_log) do
        set y (y + 1)
    end
    # Canopy goes with the first cut. A neighbour felled first can have taken the leaf above
    # this trunk, and then it's the cuts that find what's left of the crown.
    if ({block_at p[0] (y + 1) p[2]} == :canopy) { clear_canopy p[0] (y + 1) p[2] }
    world_set_block p[0] y p[2] :air
    prune_around p[0] y p[2]
    return (y > p[1])
end

fn clear_canopy [x y z] do
    for dx in (-3..=3) do
        for dz in (-3..=3) do
            for dy in (-3..=3) do
                if ({block_at (x + dx) (y + dy) (z + dz)} == :canopy) {
                    world_set_block (x + dx) (y + dy) (z + dz) :air
                }
            end
        end
    end
end

fn near_trunk [x y z] do
    for dx in ((0 - LEAF_REACH)..=LEAF_REACH) do
        for dz in ((0 - LEAF_REACH)..=LEAF_REACH) do
            for dy in ((0 - LEAF_REACH)..=LEAF_REACH) do
                if ({block_at (x + dx) (y + dy) (z + dz)} == :timber_log) { return true }
            end
        end
    end
    return false
end

# Whatever takes a trunk can strand its crown. A leaf that loses its last log was within
# LEAF_REACH of that log, so checking around each cut catches every one.
fn prune_canopy [x0 y0 z0 x1 y1 z1] do
    for x in (x0..=x1) do
        for z in (z0..=z1) do
            for y in (y0..=y1) do
                if (({block_at x y z} == :canopy) and (not {near_trunk x y z})) {
                    world_set_block x y z :air
                }
            end
        end
    end
end

fn prune_around [x y z] do
    prune_canopy (x - LEAF_REACH) (y - LEAF_REACH) (z - LEAF_REACH) (x + LEAF_REACH) (y + LEAF_REACH) (z + LEAF_REACH)
end

fn finish_harvest [w] do
    let p w.target
    let block {block_at p[0] p[1] p[2]}
    let info {harvest_info block}
    if (info == nil) { return drop_job w }

    let more false
    if (block == :timber_log) do
        set more {fell_log p}
    elif (block == :berry_bush) do
        world_set_block p[0] p[1] p[2] :berry_bush_bare
        factions[w.faction].regrow.push {=x p[0] =y p[1] =z p[2] =at ({game_tick} + (BUSH_REGROW_SECONDS * 30))}
    else do
        world_set_block p[0] p[1] p[2] :air
    end

    if ((w.carry_kind != info.kind) and (w.carry_n > 0)) { set w.carry_n 0 }
    set w.carry_kind info.kind
    set w.carry_n (w.carry_n + info.units)

    if (more and (w.carry_n < CARRY_CAP)) {
        return begin_harvest w
    }
    release_block w.faction p[0] p[1] p[2] w.id
    set w.target nil

    if (w.carry_n >= CARRY_CAP) {
        return start_carry w
    }
    start_gather w info.kind
end

# ---- Hauling ----------------------------------------------------------------

# Take this load to wherever it's wanted. A site that needs it is nearer than the yard and back.
fn start_carry [w] do
    if {start_delivery w} do
        set w.load_waits 0
        return nil
    end
    # A cell comes free every few seconds, which is sooner than the yard and back
    let f factions[w.faction]
    if ((w.load_waits < LOAD_WAIT_TRIES) and (not {yard_short_of f w.carry_kind}) and {sites_need f w.carry_kind}) do
        set w.load_waits (w.load_waits + 1)
        set w.state :resting
        set w.timer LOAD_WAIT_SECONDS
        return nil
    end
    set w.load_waits 0
    start_haul w
end

fn site_needs [site kind] do
    let left {site_remaining site}
    for block in left.keys do
        if ({BLOCK_MATERIAL.get block} == kind) { return true }
    end
    return false
end

fn sites_need [f kind] do
    if ((f.zone.expanding != nil) and {site_needs f.zone.expanding kind}) { return true }
    for b in f.sites do
        if {site_needs b.site kind} { return true }
    end
    return false
end

fn start_delivery [w] do
    let f factions[w.faction]
    # What was gathered for a site goes to it
    if ((w.supplying != nil) and {try_deliver w w.supplying}) { return true }
    if {yard_short_of f w.carry_kind} { return false }
    if ((f.zone.expanding != nil) and {try_deliver w f.zone.expanding}) { return true }
    for b in f.sites do
        if {site_needs b.site w.carry_kind} do
            if {try_deliver w b.site} { return true }
            # First in line waits for its turn, or a load a site down leaves everything half built
            if (w.load_waits < LOAD_WAIT_TRIES) { return false }
        end
    end
    return false
end

# Eating and mustering can only draw on the yard, so sites mustn't take all that's coming in. A
# unit with no bed to go to can wait: it may be the site that's building the bed.
fn yard_short_of [f kind] do
    let stock {stock_of f kind}
    if ((kind == :provisions) and (stock < FOOD_RESERVE)) { return true }
    if ((f.muster.length == 0) or ({population f} >= f.housing)) { return false }
    let cost {UNITS.get f.muster[0]}.cost
    return ({cost.has kind} and (stock < {cost.get kind}))
end

fn try_deliver [w site] do
    let pos {worker_pos w}
    if (pos == nil) { return false }
    let cell {site_claim site w.id pos[0] pos[1] pos[2]}
    if (cell == nil) { return false }
    # Layers go bottom-up, so a site's foundations stand between a load and where it's going
    let material {BLOCK_MATERIAL.get cell.block}
    let usable ((material == w.carry_kind) or ((material == nil) and {site_needs site w.carry_kind}))
    if ((not usable) or {in_danger factions[w.faction] cell.x cell.z}) do
        site_release site w.id
        return false
    end
    set w.job :build
    set w.site site
    set w.cell cell
    set w.supplying nil
    go_build_near w cell.x cell.y cell.z :place_block
    return true
end

# A Hand is on a later site because the ones before it had no cell free. As soon as one has, what's
# left of the load goes back there: sites get finished in the order they're queued.
fn deliver_ahead_of [w site] do
    let f factions[w.faction]
    if (site == f.zone.expanding) { return false }
    let queue []
    if (f.zone.expanding != nil) { queue.push f.zone.expanding }
    for b in f.sites do
        queue.push b.site
    end
    for ahead in queue do
        if (ahead == site) { return false }
        if ({site_needs ahead w.carry_kind} and {try_deliver w ahead}) do
            site_release site w.id
            return true
        end
    end
    return false
end

fn start_haul [w] do
    let pos {worker_pos w}
    if (pos == nil) { return nil }
    let zone {zone_of w}
    let slot {find_deposit_slot zone w.carry_kind pos[0] pos[2]}
    if (slot == nil) do
        # Yard's full. Ask for a floor, and help build it with what's in hand.
        let f factions[w.faction]
        zone_plan_floor zone
        set w.state :idle
        set w.carry_n 0
        return nil
    end
    set w.job :haul
    go_to w (slot.x + 0.5) slot.y (slot.z + 0.5) 1.5 :deposit
end

fn finish_deposit [w] do
    let pos {worker_pos w}
    if (pos == nil) { return nil }
    let left {zone_deposit {zone_of w} w.carry_kind w.carry_n pos[0] pos[2]}
    set w.carry_n left
    if (left == 0) { set w.carry_kind nil }
    set w.job nil
    set w.state :idle
end

# ---- Eating -----------------------------------------------------------------

fn start_eat [w] do
    let pos {worker_pos w}
    let zone {zone_of w}
    let slot {find_take_slot zone :provisions pos[0] pos[2]}
    if (slot == nil) { return pick_job_no_eat w }
    set w.job :eat
    go_to w (slot.x + 0.5) slot.y (slot.z + 0.5) 1.5 :eat
end

fn pick_job_no_eat [w] do
    set w.hunger HUNGER_EAT_AT
    set w.state :idle
end

fn finish_eat [w] do
    let pos {worker_pos w}
    if ({zone_take {zone_of w} :provisions 1 pos[0] pos[2]} > 0) { set w.hunger 1.0 }
    set w.job nil
    set w.state :idle
end

# ---- Building ---------------------------------------------------------------

fn start_build [w site] do
    let pos {worker_pos w}
    if (pos == nil) { return nil }
    let cell {site_claim site w.id pos[0] pos[1] pos[2]}
    if ((cell != nil) and {in_danger factions[w.faction] cell.x cell.z}) do
        site_release site w.id
        set cell nil
    end
    if (cell == nil) do
        # Everything's claimed by others. Do something useful meanwhile.
        if (w.carry_n > 0) { return start_carry w }
        return start_gather w {wanted_kind factions[w.faction]}
    end

    set w.job :build
    set w.site site
    set w.cell cell

    let material {BLOCK_MATERIAL.get cell.block}
    if ((material == nil) or ((w.carry_kind == material) and (w.carry_n > 0))) do
        go_build_near w cell.x cell.y cell.z :place_block
        return nil
    end

    # Fetch materials first. If there are none, the claim goes back.
    if ((w.carry_n > 0) and (w.carry_kind != material)) do
        site_release site w.id
        set w.site nil
        set w.cell nil
        set w.job nil
        return start_carry w
    end

    let slot {find_take_slot {zone_of w} material pos[0] pos[2]}
    if (slot == nil) do
        site_release site w.id
        set w.site nil
        set w.cell nil
        set w.job nil
        set w.supplying site
        return start_gather w material
    end
    set w.kind material
    go_to w (slot.x + 0.5) slot.y (slot.z + 0.5) 1.5 :fetched
end

fn finish_fetch [w] do
    let pos {worker_pos w}
    let got {zone_take {zone_of w} w.kind CARRY_CAP pos[0] pos[2]}
    if (got == 0) { return drop_job w }
    set w.carry_kind w.kind
    set w.carry_n got
    let cell w.cell
    go_build_near w cell.x cell.y cell.z :place_block
end

fn begin_place [w] do
    let cell w.cell
    ent_look_at w.id (cell.x + 0.5) (cell.y + 0.5) (cell.z + 0.5)
    wait_for w 0.5 :placed
end

fn finish_place [w] do
    let cell w.cell
    let cut ({block_at cell.x cell.y cell.z} == :timber_log)
    world_set_block cell.x cell.y cell.z cell.block
    if cut { prune_around cell.x cell.y cell.z }
    let material {BLOCK_MATERIAL.get cell.block}
    if (material != nil) do
        set w.carry_n (w.carry_n - 1)
        if (w.carry_n <= 0) do
            set w.carry_n 0
            set w.carry_kind nil
        end
    end
    let site w.site
    set w.cell nil
    set w.site nil
    # A gatherer who brought a load goes back for more, or nobody's keeping materials coming. A
    # builder who was only dropping one off goes back to the front of the line.
    if ((w.carry_n == 0) and ((not {is_builder w}) or (site != {next_site factions[w.faction]}))) do
        site_release site w.id
        set w.job nil
        set w.state :idle
        return nil
    end
    if ((w.carry_n > 0) and {deliver_ahead_of w site}) { return nil }
    start_build w site
end

# ---- Quartermaster defrag ---------------------------------------------------

fn start_defrag [w move] do
    set w.job :defrag
    set w.target move
    let s move.from
    go_to w (s.x + 0.5) s.y (s.z + 0.5) 1.5 :defrag_take
end

fn finish_defrag_take [w] do
    let move w.target
    let s move.from
    if ((s.kind != move.kind) or (s.amount <= 0)) { return drop_job w }
    set w.carry_kind move.kind
    set w.carry_n s.amount
    set s.amount 0
    slot_paint s
    set w.target nil
    start_haul w
end

# ---- Think ------------------------------------------------------------------

fn on_arrive [w] do
    ent_nav_ack w.id
    match w.after
        :harvest { begin_harvest w }
        :deposit { finish_deposit w }
        :eat { finish_eat w }
        :fetched { finish_fetch w }
        :place_block { begin_place w }
        :defrag_take { finish_defrag_take w }
        :rally { set w.state :idle }
        _ { set w.state :idle }
    end
end

fn on_work_done [w] do
    ent_anim w.id :idle
    match w.after
        :harvested { finish_harvest w }
        :placed { finish_place w }
        :scaffolded { ent_nav_resume w.id; set w.state :moving }
        _ { set w.state :idle }
    end
end

# A constructive path stopped us at a step that needs a block. Spend one.
fn handle_nav_block [w] do
    let action {ent_nav_action w.id}
    if (action == nil) { return nil }
    if (action.kind == :place) do
        let p action.pos
        world_set_block p[0] p[1] p[2] :scaffold
        factions[w.faction].scaffold.push p
        set w.state :working
        set w.timer 0.3
        set w.after :scaffolded
    else do
        let p action.pos
        world_set_block p[0] p[1] p[2] :air
        ent_nav_resume w.id
    end
end

# Where raiders were seen, for the whole side to keep clear of. One on the move keeps its mark.
fn note_danger [f x z] do
    let ends ({game_tick} + (DANGER_SECONDS * 30))
    for spot in f.danger do
        if ({dist2 spot.x spot.z x z} < (DANGER_RADIUS * DANGER_RADIUS)) do
            set spot.x x
            set spot.z z
            set spot.ends ends
            return nil
        end
    end
    f.danger.push {=x x =z z =ends ends}
end

fn in_danger [f x z] do
    for spot in f.danger do
        if ({dist2 spot.x spot.z x z} < (DANGER_RADIUS * DANGER_RADIUS)) { return true }
    end
    return false
end

fn forget_danger [f] do
    let tick {game_tick}
    let i 0
    while (i < f.danger.length) do
        if (tick >= f.danger[i].ends) { f.danger.remove i } { set i (i + 1) }
    end
end

# Who's near, or who hurt this Hand: a bow reaches further than it looks
fn threat_to [w pos] do
    let near {ent_find pos[0] pos[1] pos[2] FLEE_RADIUS =enemy_of w.faction =max 1}
    if (near.length > 0) { return near[0] }
    if ({ent_since_damage w.id} <= STRUCK_SECONDS) do
        let id {ent_last_attacker w.id}
        if {ent_alive id} { return id }
    end
    return nil
end

# Hands aren't soldiers. With raiders close they drop everything and run for home, and they don't
# turn back the moment they're clear: what they were doing is still where the raiders are.
fn check_danger [w] do
    set w.danger_check (w.danger_check - THINK_SECONDS)
    if (w.danger_check > 0.0) { return false }
    set w.danger_check FLEE_CHECK_SECONDS

    let pos {worker_pos w}
    if (pos == nil) { return false }
    let threat {threat_to w pos}
    if (threat == nil) do
        if ((w.state == :fleeing) and ({game_tick} >= w.calm_at)) { set w.state :idle }
        return false
    end
    let f factions[w.faction]
    raise_alarm f pos
    let at {ent_pos threat}
    if (at == nil) { set at pos }
    note_danger f at[0] at[2]
    set w.calm_at ({game_tick} + (FLEE_CALM_SECONDS * 30))
    if (w.state != :fleeing) do
        drop_job w
        set w.state :fleeing
        ent_goto w.id f.x f.y (f.z + 1) =range 3.0 =partial true =max_nodes 6000
    end
    return true
end

fn think [w] do
    set w.hunger (w.hunger - (THINK_SECONDS / HUNGER_SECONDS))
    if (w.hunger < 0.0) { set w.hunger 0.0 }

    if {check_danger w} { return nil }

    match w.state
        :idle { pick_job w }
        :moving do
            let nav {ent_nav w.id}
            match nav
                :arrived do
                    set w.failures 0
                    on_arrive w
                end
                :failed do
                    ent_nav_ack w.id
                    if ((w.job == :build) and (w.after == :place_block) and (not w.scaffolding)) {
                        try_scaffolding w
                    } {
                        give_up w
                    }
                end
                :blocked { handle_nav_block w }
                :idle {
                    # Order was lost, e.g. a command replaced it
                    drop_job w
                }
                _ { nil }
            end
        end
        :working do
            set w.timer (w.timer - THINK_SECONDS)
            if (w.timer <= 0.0) { on_work_done w }
        end
        :resting do
            set w.timer (w.timer - THINK_SECONDS)
            if (w.timer <= 0.0) { set w.state :idle }
        end
        _ { nil }
    end
end
