# Keystone game script (game thread)
#
# Everything here is game policy. Mechanisms come from engine natives.

source "scripts/data.fsc"
source "scripts/util.fsc"
source "scripts/stock.fsc"
source "scripts/jobs.fsc"
source "scripts/build.fsc"
source "scripts/faction.fsc"
source "scripts/combat.fsc"
source "scripts/commander.fsc"
source "scripts/match.fsc"
source "scripts/pressures.fsc"
source "scripts/inspect.fsc"
source "scripts/tasks.fsc"
source "scripts/catalog.fsc"

fn tick_hands [f tick] do
    let i 0
    while (i < f.hands.length) do
        let w f.hands[i]
        if {ent_alive w.id} do
            if (((w.id + tick) % THINK_INTERVAL) == 0) { think w }
            set i (i + 1)
        else do
            release_claims w.id
            if (w.site != nil) { site_release w.site w.id }
            f.hands.remove i
        end
    end
end

fn tick_faction [f tick] do
    if {f.has :brigands} { return {tick_brigands f tick} }
    tick_hands f tick
    tick_army f tick
    if (f.commander != nil) { commander_tick f.commander tick }

    if ((tick % 30) == ((f.id * 7) % 30)) do
        check_buildings f
        update_sites f
        zone_reconcile f.zone
        update_regrow f tick
        forget_danger f
        update_training f
        update_muster f
        update_rations f
    end
end

fn update_regrow [f tick] do
    let i 0
    while (i < f.regrow.length) do
        let bush f.regrow[i]
        if (tick >= bush.at) do
            if ({block_at bush.x bush.y bush.z} == :berry_bush_bare) {
                world_set_block bush.x bush.y bush.z :berry_bush
            }
            f.regrow.remove i
        else do
            set i (i + 1)
        end
    end
end

# Training takes its time up front, so the clock rests full
fn update_training [f] do
    if (f.train_queue <= 0) do
        set f.train_timer HAND_TRAIN_SECONDS
        return nil
    end
    if ({population f} >= f.housing) { return nil }
    set f.train_timer (f.train_timer - 1.0)
    if (f.train_timer > 0.0) { return nil }
    if ({zone_take f.zone :provisions HAND_COST.provisions f.x f.z} < HAND_COST.provisions) {
        return nil
    }
    set f.train_queue (f.train_queue - 1)
    set f.train_timer HAND_TRAIN_SECONDS
    spawn_hand f
end

fn publish_state [f] do
    ui_publish {=stock {
                    =timber {zone_count f.zone :timber}
                    =stone {zone_count f.zone :stone}
                    =provisions {zone_count f.zone :provisions}}
                =hands {population f} =housing f.housing
                =sites f.sites.length =plots {plots_seen_by f} =home [f.x f.z]
                =queue {work_queue f}
                =army f.army.length
                =match contest.state =winner contest.winner =won {won f}
                =capture f.capture =keystones {keystones_going f}
                =alive f.alive} =faction f.id
end

# What each Hand has in hand, for a player who asked to see it (a debugging aid). Waiting means it's
# at a cell it can't fill yet, for someone being in the way.
set carry_watchers {map}

fn watch_carry [player wanted] do
    if wanted { carry_watchers.set {to_sym player} player } { carry_watchers.remove {to_sym player} }
end

fn publish_carry [] do
    for player in carry_watchers.values do
        let f {faction_of player}
        if (f != nil) do
            let hands []
            for w in f.hands do
                let waits {w.get :place_waits}
                hands.push {=id w.id =kind w.carry_kind =n w.carry_n =waiting ((waits != nil) and (waits > 0))}
            end
            ui_publish {=carry {=cap CARRY_CAP =hands hands}} =to player
        end
    end
end

# Who else is out there, for everyone: colours for their units, and a line each in the HUD
fn publish_sides [] do
    let sides []
    for f in factions do
        if ((f != nil) and {f.has :brigands}) do
            sides.push {=id f.id =color BRIGAND_COLOR =alive true =rival false =brigands true =moniker 0 =team f.team}
        elif (f != nil) do
            let color FACTION_COLORS[(f.id - 1) % FACTION_COLORS.length]
            # Saves from before sides had names
            if (not {f.has :moniker}) { set f.moniker {random_range 0 999999} }
            let owner nil
            if ({f.has :owner_name} and (f.commander == nil)) { set owner f.owner_name }
            sides.push {=id f.id =color color =alive f.alive =rival (f.commander != nil)
                        =moniker f.moniker =player owner =team f.team}
        end
    end
    ui_publish {=sides sides}
end

fn human_factions [] do
    let out []
    for f in factions do
        if ({is_side f} and (f.commander == nil)) { out.push f }
    end
    return out
end

# Nobody can click through a roof, so an order onto a rival's Hall means the Keystone inside it
fn keystone_under [f x y z] do
    if ({vision_state f.id x z} == :unknown) { return nil }
    for other in factions do
        if ((other != nil) and {hostile f other} and (other.keystone != nil) and (other.hall != nil)) do
            if {in_footprint other.hall x y z} { return other.keystone }
        end
    end
    return nil
end

# A tight block centred on the order point, so that one unit goes just where it was sent, and
# a group gets a cell each instead of all fighting for one
fn order_units [f cmd] do
    let units []
    for id in cmd.units do
        let entry {lookup_unit id}
        if ((entry != nil) and (entry.faction == f.id)) { units.push entry.record }
    end
    if (units.length == 0) { return nil }
    let queued ({cmd.has :queue} and cmd.queue)
    let x {floor cmd.x}
    let y {floor cmd.y}
    let z {floor cmd.z}
    let k {keystone_under f x y z}
    if (k != nil) { return {send_formation units [k] queued false} }
    let b {building_to_break f x y z}
    if (b != nil) { return {order_wreck units b queued} }
    return {send_formation units {order_spots f x y z {centre_of units}} queued true}
end

# Where an order goes is the first of the spots, and the rest are where to try if that can't be got
# to. Each unit stands at the height nearest it in its own place in the formation, unless told not to.
fn send_formation [units spots queued settle] do
    let at spots[0]
    let formed {formation units (at[0] + 0.5) (at[2] + 0.5)}
    let i 0
    for record in formed.order do
        let x formed.at[i][0]
        let z formed.at[i][1]
        set i (i + 1)
        let y at[1]
        if settle do
            let stand {stand_y {floor x} {floor z} at[1]}
            if (stand != nil) { set y stand }
        end
        if (queued and {under_orders record}) do
            let ways {waypoints_of record}
            ways.push [x y z]
        else do
            set record.waypoints []
            send_unit record x y z
            let rest []
            for j in (1..spots.length) do
                rest.push spots[j]
            end
            set record.fallbacks rest
        end
    end
    return at
end

# An order's next place to try, when the last couldn't be got to
fn try_fallback [record] do
    let rest {record.get :fallbacks}
    if ((rest == nil) or (rest.length == 0)) { return false }
    let p rest[0]
    rest.remove 0
    send_unit record p[0] p[1] p[2]
    set record.fallbacks rest
    return true
end

fn centre_of [units] do
    let sx 0.0
    let sz 0.0
    let n 0
    for r in units do
        let p {ent_pos r.id}
        if (p != nil) do
            set sx (sx + p[0])
            set sz (sz + p[2])
            set n (n + 1)
        end
    end
    if (n == 0) { return nil }
    return [(sx / n) (sz / n)]
end

# ---- Where an order means ----------------------------------------------------
#
# Nobody means the top of a roof or a tree. An order means the nearest place a unit could stand
# that the click could stand for, and then on down to somewhere it surely can: a building's floors,
# highest first, each under a roof, and then the ground just outside.

fn building_at [x y z] do
    for f in factions do
        if {is_side f} do
            let b {structure_at f x y z}
            if ((b != nil) and (not {b.has :laid})) { return b }
        end
    end
    return nil
end

# Into the fog, a click is taken as it is: the game knows what's there, and the pin would tell
fn order_spots [f x y z near] do
    if ({vision_state f.id x z} == :unknown) { return [[x y z]] }
    let b {building_at x y z}
    if (b != nil) do
        let spots {floors_in b x y z}
        if ((spots.length == 0) and {can_stand x y z}) { spots.push [x y z] }
        if (near == nil) { set near [x z] }
        let out {outside_of b near}
        if (out != nil) { spots.push out }
        if (spots.length > 0) { return spots }
    end
    if {SOFT_BLOCKS.contains {block_at x (y - 1) z}} do
        # Up a tree, or on a bush: at its foot
        let g {ground_y x z}
        if (g != nil) { return [[x (g + 1) z]] }
    end
    return [[x y z]]
end

# The first height clear of it
fn structure_top [b] do
    if (b.name == :core_hall) { return (b.y + {blueprint_info :core_hall}.size_y) }
    return (b.y + {building_height b})
end

# Room to stand with something overhead, at or below the click, nearest it first. A floor more than
# a step below the best one is another floor, and comes next.
fn floors_in [b x y z] do
    let plot {plot_of b}
    let top {structure_top b}
    let found []
    for cx in (plot[0]..plot[2]) do
        for cz in (plot[1]..plot[3]) do
            let roof (top - 1)
            while ((roof >= b.y) and ({block_at cx roof cz} == :air)) do
                set roof (roof - 1)
            end
            for cy in (b.y..={min_int y (roof - 2)}) do
                if {can_stand cx cy cz} do
                    let score ({dist2 x z cx cz} + (4 * (y - cy) * (y - cy)))
                    found.push {=at [cx cy cz] =score score}
                end
            end
        end
    end
    found.sort_by fn [p q] (p.score < q.score)
    let spots []
    for c in found do
        if ((spots.length == 0) or (c.at[1] < (spots[spots.length - 1][1] - 1))) { spots.push c.at }
    end
    return spots
end

# The ground just round it nearest (x, z)
fn outside_of [b near] do
    let plot {plot_of b}
    let best nil
    let best_d 0.0
    for cx in ((plot[0] - 1)..=plot[2]) do
        for cz in ((plot[1] - 1)..=plot[3]) do
            let edge ((cx == (plot[0] - 1)) or (cx == plot[2]) or (cz == (plot[1] - 1)) or (cz == plot[3]))
            if edge do
                let cy {stand_y cx cz b.y}
                let d {dist2 near[0] near[1] (cx + 0.5) (cz + 0.5)}
                if ((cy != nil) and ((best == nil) or (d < best_d))) do
                    set best [cx cy cz]
                    set best_d d
                end
            end
        end
    end
    return best
end

# An order onto a building of the enemy's that this side can see means breaking it
fn building_to_break [f x y z] do
    if ({vision_state f.id x z} == :unknown) { return nil }
    for other in factions do
        if ((other != nil) and {hostile f other}) do
            for b in other.buildings do
                if {in_footprint b x y z} { return b }
            end
        end
    end
    return nil
end

# Those who can break it go at it. The rest wait just outside, on the near side.
fn order_wreck [units b queued] do
    let out {outside_of b {centre_of units}}
    if (out == nil) { set out [b.x b.y b.z] }
    let others []
    for record in units do
        if ({record.has :stats} and {can_wreck record}) do
            set record.waypoints []
            order_soldier record out[0] out[1] out[2]
            set record.order nil
            set record.post out
            wreck record b true
        else do
            others.push record
        end
    end
    if (others.length > 0) { send_formation others [out] queued true }
    return out
end

# Ranks facing the way they're going: those who fight hand to hand in front, bows behind them, then
# everyone else. A line is wider than it's deep.
fn formation [units x z] do
    let sx 0.0
    let sz 0.0
    let counted 0
    let order []
    for rank in [:melee :ranged :other] do
        for r in units do
            let role :other
            if {r.has :stats} { set role r.stats.role }
            if ((role != :melee) and (role != :ranged)) { set role :other }
            if (role == rank) { order.push r }
        end
    end
    for r in units do
        let p {ent_pos r.id}
        if (p != nil) do
            set sx (sx + p[0])
            set sz (sz + p[2])
            set counted (counted + 1)
        end
    end
    # Facing: from where they are to where they're going, or north if they're there already
    let fx 0.0
    let fz -1.0
    if (counted > 0) do
        let dx (x - (sx / counted))
        let dz (z - (sz / counted))
        let d {sqrt ((dx * dx) + (dz * dz))}
        if (d > 1.0) do
            set fx (dx / d)
            set fz (dz / d)
        end
    end
    let count order.length
    let across 1
    while ((across * across) < (count * 2)) do
        set across (across + 1)
    end
    if (across > count) { set across count }
    let rows {floor ((count + across - 1) / across)}
    let at []
    for i in (0..count) do
        let col ((i % across) - ((across - 1) / 2.0))
        let row ({floor (i / across)} - ((rows - 1) / 2.0))
        # Right of the facing is (-fz, fx); the front row is furthest along it
        at.push [(x + (col * FORMATION_SPACING * (0 - fz)) - (row * FORMATION_SPACING * fx))
                 (z + (col * FORMATION_SPACING * fx) - (row * FORMATION_SPACING * fz))]
    end
    return {=order order =at at}
end

# Busy with an order from the player, which a waypoint waits behind
fn under_orders [record] do
    if {record.has :stats} { return ((record.order == :move) or (record.hunting != nil)) }
    return ((record.state == :moving) and (record.after == :rally))
end

fn waypoints_of [record] do
    if (not {record.has :waypoints}) { set record.waypoints [] }
    return record.waypoints
end

fn send_unit [record x y z] do
    if {record.has :stats} do
        order_soldier record x y z
    else do
        drop_job record
        set record.state :moving
        set record.after :rally
        ent_goto record.id x y z =range ORDER_RANGE =partial true =max_nodes 6000
    end
end

# Where a player's order goes next, once it's at the last place. False if there's nowhere.
fn next_waypoint [record] do
    let ways {waypoints_of record}
    if (ways.length == 0) { return false }
    let p ways[0]
    ways.remove 0
    send_unit record p[0] p[1] p[2]
    return true
end

# The Steward works like one strong Hand: useful early, never a hero (DESIGN 1)
fn steward_break [f x y z] do
    if {game_paused} { return nil }
    let block {block_at x y z}
    let info {HARVEST.get block}
    if (info == nil) do
        # What was laid comes back to the stockpile, and the ground can be dug
        let kind {BLOCK_MATERIAL.get block}
        if (kind != nil) do
            world_set_block x y z :air
            zone_deposit f.zone kind 1 x z
        elif {TERRAIN_BLOCKS.contains block} do
            world_set_block x y z :air
        end
        return nil
    end
    if (block == :timber_log) do
        fell_log [x y z]
    elif (block == :berry_bush) do
        world_set_block x y z :berry_bush_bare
        f.regrow.push {=x x =y y =z z =at ({game_tick} + (BUSH_REGROW_SECONDS * 30))}
    else do
        world_set_block x y z :air
    end
    zone_deposit f.zone info.kind info.units x z
end

fn steward_place [f x y z block] do
    let kind {BLOCK_MATERIAL.get block}
    if {game_paused} { return nil }
    if ((kind == nil) or ({block_at x y z} != :air)) { return nil }
    if ({zone_take f.zone kind 1 x z} == 0) do
        ui_publish {=denied {sym_name kind}} =faction f.id
        return nil
    end
    world_set_block x y z block
end

set RIVAL_LEVEL :standard

on :start do
    log "Keystone starting, seed" WORLD_SEED
    hold_time_of_day TIME_OF_DAY

    let rivals {SETTINGS.get :rivals}
    if (rivals == nil) { set rivals 1 }
    let level {SETTINGS.get :rival_level}
    if (level == nil) { set level RIVAL_LEVEL }

    # With nobody seated, it's a scenario, and the first side is the one it plays
    let humans {max PLAYERS.length 1}
    let count (humans + rivals)
    if (count == 1) { set count 2 }
    let teams {SETTINGS.get :teams}

    for i in (0..humans) do
        let spot {settlement_spot i count}
        let f {make_faction (i + 1) spot[0] spot[1]}
        vision_add_faction f.id
        endow_new f
        if (i < PLAYERS.length) do
            set f.owner PLAYERS[i].id
            set f.owner_name PLAYERS[i].name
            player_bind PLAYERS[i].id f.id =at {steward_home f}
        end
        if (teams == :versus) do
            set_team f 1
        elif (teams == :custom) do
            let chosen nil
            if (i < PLAYERS.length) { set chosen PLAYERS[i].settings.team }
            if (chosen == nil) { set chosen 1 }
            set_team f chosen
        else do
            set_team f f.team
        end
    end

    for i in (humans..(humans + rivals)) do
        let spot {settlement_spot i count}
        let rival {make_faction (i + 1) spot[0] spot[1]}
        vision_add_faction rival.id
        endow_new rival
        set rival.commander {make_commander rival level}
        if (teams == :versus) do
            set_team rival 2
        elif (teams == :custom) do
            let number (i - humans + 1)
            let chosen {SETTINGS.get {to_sym "rival_team_{number}"}}
            if (chosen == nil) { set chosen 2 }
            set_team rival chosen
        else do
            set_team rival rival.team
        end
    end

    plant_groves
    let brigands {SETTINGS.get :brigands}
    if (brigands != false) { make_brigands }
    log "settlements:" {alive_factions}.length
end

# Stopping the clock only makes sense with nobody else waiting on it
fn set_paused [paused] do
    if ({human_factions}.length == 1) { game_pause paused }
end

on :player_join do
    game_pause false
    seat_player player
end

on :save do
    game_state_store {=factions factions =unit_index unit_index =contest contest}
end

# Paths, work claims, and shots in flight aren't saved, so whatever units were in the
# middle of is gone. Hands choose new work and keep what they carry; soldiers keep orders.
fn settle_after_resume [f] do
    for w in f.hands do
        set w.state :idle
        set w.job nil
        set w.site nil
        set w.cell nil
        set w.target nil
        set w.after nil
        set w.retry 0
        set w.timer 0.0
        set w.scaffolding false
        set w.supplying nil
        set w.calm_at 0
        set w.load_waits 0
        set w.queue_at nil
        ent_anim w.id :idle
    end
    if (not {f.has :danger}) { set f.danger [] }
    for s in f.army do
        set s.moving false
        set s.target nil
        set s.last_pos nil
        set s.striking 0.0
        set s.ignore nil
        set s.ignore_until 0
        if (not {s.has :dead_ends}) do
            set s.dead_ends []
            set s.explore_wait 0.0
            set s.explore_from nil
        end
        if (not {s.has :post}) do
            set s.post nil
            set s.errand nil
        end
        set s.hunting nil
        set s.hunt_fails 0
        set s.hunt_blind 0.0
        set s.siege nil
        set s.siege_wait 0.0
        if (not {s.has :wreck}) do
            set s.wreck nil
            set s.wreck_wait 0.0
            set s.fallbacks []
        end
        set s.wreck_cell nil
        set s.wreck_blows 0
        set s.wreck_tries 0
        ent_anim s.id :idle
    end
    # Saves from before the Hall was noted. One that's lost its Keystone can't say where it stood.
    if (not {f.has :hall}) do
        set f.hall nil
        if (f.keystone != nil) { note_hall f (f.keystone[0] - 4) (f.keystone[1] - 1) (f.keystone[2] - 4) }
    end
    repair_canopy f
    repair_huts f
end

# Saves from before the Forager Hut's far posts were moved in. They stood a row past its floor and
# roof, touching neither. The hut is long that way, so that's the way back onto the floor.
fn repair_huts [f] do
    for b in f.buildings do
        if (b.name == :forager_hut) do
            let x0 (b.x - (b.size_x / 2))
            let z0 (b.z - (b.size_z / 2))
            for x in (x0..(x0 + b.size_x)) do
                for z in (z0..(z0 + b.size_z)) do
                    let to_x x
                    let to_z z
                    if (b.size_x > b.size_z) { set to_x (x + {clamp (b.x - x) -1 1}) }
                    if (b.size_z > b.size_x) { set to_z (z + {clamp (b.z - z) -1 1}) }
                    if (({block_at x b.y z} != :planks) and ({block_at to_x b.y to_z} == :planks)) do
                        for y in ((b.y + 1)..=(b.y + 2)) do
                            if ({block_at x y z} == :palisade) do
                                world_set_block x y z :air
                                world_set_block to_x y to_z :palisade
                            end
                        end
                    end
                end
            end
        end
    end
end

# Saves from before every cut cleaned up after itself. Once, over everywhere Hands work:
# crowns are at the top of a column, so a tree's height down from the surface will do.
fn repair_canopy [f] do
    if ({f.get :canopy_repaired} == true) { return nil }
    set f.canopy_repaired true
    for x in ((f.x - SEARCH_RADIUS)..=(f.x + SEARCH_RADIUS)) do
        for z in ((f.z - SEARCH_RADIUS)..=(f.z + SEARCH_RADIUS)) do
            let top {surface_y x z}
            if (top != nil) { prune_canopy x (top - CROWN_DEPTH) z x top z }
        end
    end
end

on :resume do
    hold_time_of_day TIME_OF_DAY
    let saved {game_state_load}
    set factions saved.factions
    set unit_index saved.unit_index
    set contest saved.contest
    for f in factions do
        if (f != nil) do
            # Saves from before teams had everyone on their own
            if (not {f.has :team}) { set f.team (SOLO_TEAM + f.id) }
            set_team f f.team
            settle_after_resume f
        end
    end
    log "resumed at t=" ({game_tick} / 30)
end

fn publish_all [tick] do
    if ((tick % 15) == 0) {
        for f in {human_factions} do
            publish_state f
        end
    }
    if ((tick % 30) == 7) { publish_sides }
    if ((tick % 6) == 0) {
        for f in {human_factions} do
            publish_ghosts f
        end
        publish_carry
    }
end

on :tick do
    let tick {game_tick}
    for f in factions do
        if (f != nil) { tick_faction f tick }
    end
    if ((tick % 30) == 3) { tick_match }
    publish_all tick
end

# Orders still come in with the game stopped, and players want to see them land
set paused_ticks 0

on :paused_tick do
    set paused_ticks (paused_ticks + 1)
    publish_all paused_ticks
end

on :command do
    let f {faction_of sender}
    match cmd.name
        :move do
            # Where the units really went, for the pin: not always where the click was
            let at {order_units f cmd}
            if (at != nil) { ui_publish {=order_at {=units cmd.units =x at[0] =y at[1] =z at[2]}} =to sender }
        end
        :attack { order_attack f cmd }
        :build { if ({place_building f cmd.building cmd.x cmd.z cmd.turns} == nil) { ui_publish {=taken true} =to sender } }
        :train { set f.train_queue (f.train_queue + {batch_size cmd}) }
        :muster { queue_many f cmd.unit {batch_size cmd} }
        :pause { set_paused cmd.paused }
        :continue { if (contest.state == :over) { continue_open_ended cmd.pacify } }
        :steward_break { steward_break f cmd.x cmd.y cmd.z }
        :steward_place { steward_place f cmd.x cmd.y cmd.z cmd.block }
        :lay { lay_blocks f cmd.block cmd.x0 cmd.z0 cmd.x1 cmd.z1 }
        :fence { lay_fence f cmd.cells }
        :tasks { ui_publish {=tasks {tasks_of cmd.units}} =to sender }
        :catalog { ui_publish {=catalog {catalog_of}} =to sender }
        :inspect { ui_publish {=inspect {inspect_at f.id cmd.x cmd.y cmd.z}} =to sender }
        :watch_carry { watch_carry sender cmd.show }
        _ { log "unknown command" cmd.name }
    end
end
