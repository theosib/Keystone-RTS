# Game data: everything tunable lives here.

set KIND_NAMES [:timber :stone :provisions]

# How near a unit has to get to where it was sent, and how near will do if it can't get closer
set ORDER_RANGE 1.5
set ORDER_GIVE_UP_RANGE 6.0

# Blocks a Hand carries at once, and units a resource block holds
set CARRY_CAP 3
set STACK_UNITS 8

# What a block costs to place. Blocks not listed are free.
set BLOCK_MATERIAL {
    =planks :timber =palisade :timber =scaffold :timber
    =log_palisade :timber =log_palisade_top :timber
    =thatch :provisions
    =flagstone :stone =dressed_stone :stone =gravel_path :stone
}

# Harvesting: source block -> resource, units per block, work seconds
set HARVEST {
    =timber_log {=kind :timber =units 2 =seconds 1.4}
    =boulder {=kind :stone =units 2 =seconds 1.8}
    =berry_bush {=kind :provisions =units 3 =seconds 1.0}
}
set HARVEST_BLOCKS {=timber [:timber_log] =stone [:boulder] =provisions [:berry_bush]}

set SEARCH_RADIUS 72
# The generator never sets a leaf further than this from its trunk
set LEAF_REACH 2
set CROWN_DEPTH 12
set BUSH_REGROW_SECONDS 90.0

# Hunger: full at 1.0, falls to 0 over this many seconds
set HUNGER_SECONDS 360.0
set HUNGER_EAT_AT 0.35

set HAND_COST {=provisions 5}
set HAND_TRAIN_SECONDS 10.0

# Laid into the ground rather than set on top of it
set SURFACE_BLOCKS [:gravel_path :flagstone]
set LAY_MAX_CELLS 32
# One section of wall, from the ground up
set FENCE_BLOCKS [:log_palisade :log_palisade :log_palisade_top]

set BUILDINGS {
    =shelter {=blueprint :shelter =housing 4}
    =forager_hut {=blueprint :forager_hut =gather_bonus :provisions}
    =sawpit {=blueprint :sawpit =gather_bonus :timber}
    =watchtower {=blueprint :watchtower =vision 44.0 =eye_height 11.0}
    =palisade_wall {=blueprint :palisade_wall}
}

set BASE_HOUSING 8

# Ground cleared around a settlement, either side of its centre and above and below its level
set LEVEL_RADIUS 14
set LEVEL_HEIGHT 24

# Hands run from raiders this close, for home
set FLEE_RADIUS 9
set FLEE_CHECK_SECONDS 1.0
set GATHER_BONUS_RADIUS 32
set GATHER_BONUS_SPEED 0.7

# Thinks per second is 30 / THINK_INTERVAL
set THINK_INTERVAL 8
set THINK_SECONDS (THINK_INTERVAL / 30.0)

# ---- Units ------------------------------------------------------------------
# kind: melee or ranged. range is reach for melee, draw length for ranged.
set UNITS {
    =militia {=role :melee =damage 8.0 =range 2.2 =cooldown 1.0 =aggro 16
              =cost {=timber 4 =provisions 8}}
    =shortbow {=role :ranged =damage 6.0 =range 18.0 =cooldown 1.7 =aggro 20
               =cost {=timber 8 =provisions 6}}
    =scout {=role :scout =damage 0.0 =range 0.0 =cooldown 1.0 =aggro 0
            =cost {=provisions 8}}
}
set TRAIN_SECONDS 8.0
# One swing of the work animation
set STRIKE_SECONDS 0.8
set ARROW_SPEED 26.0
set CHASE_REPATH_DISTANCE_SQ 16
set CHASE_GIVE_UP_SECONDS 7.0

# Actual height wins fights (DESIGN 6.2)
set HIGH_GROUND_RANGE_PER_BLOCKS 2.0
set HIGH_GROUND_DAMAGE 1.15

# Morale: 1.0 is steady. Units rout below ROUT_AT and rally above RALLY_AT.
set ROUT_AT 0.25
set RALLY_AT 0.6
set MORALE_LOSS_HIT 0.06
set MORALE_LOSS_ALLY_DOWN 0.12
set MORALE_LOSS_OUTNUMBERED 0.05
set MORALE_GAIN_NEAR_HOME 0.12
set MORALE_GAIN_RESTING 0.03

# Conquest: enemy-seconds at the Keystone, unopposed, to take it
set KEYSTONE_CAPTURE_POINTS 40
# Reaches the Hall's walls and doorway: being inside the Hall is what counts
set KEYSTONE_RADIUS 7
