# Game data: everything tunable lives here.

set KIND_NAMES [:timber :stone :provisions]

# Nights have no part in the game yet, so the sun stays here: 0 dawn, 0.25 noon, 0.5 dusk
set TIME_OF_DAY 0.18

# How near a unit has to get to where it was sent, and how near will do if it can't get closer
set ORDER_RANGE 1.5
set ORDER_GIVE_UP_RANGE 6.0
# Blocks between neighbours in a formation
set FORMATION_SPACING 1.6

# Blocks a Hand carries at once, and units a resource block holds
set CARRY_CAP 3
set STACK_UNITS 8
# A load a site will want waits this long, this many times, for a cell before going to the yard
set LOAD_WAIT_SECONDS 1.5
set LOAD_WAIT_TRIES 4
# How far out from a finished building its scaffolding is taken down
set SCAFFOLD_REACH 3
# Thinks a Hand waits for someone to step out of where a block goes, before it gives that up
set PLACE_WAIT_TRIES 8
# How near a site a Hand waiting on it stands
set QUEUE_NEAR 3.0
# Who builds what is solved for a whole side this often, in ticks
set BOARD_INTERVAL 15
# A site this many blocks' walk ahead of the next in line: earlier sites come first, unless much further
set BOARD_SITE_PRIORITY 25.0
# A Hand moves to another cell only if it's this many blocks better
set BOARD_STICK 3.0
# This near its cell, a Hand keeps it
set BOARD_NEAR 3.0

# What a block costs to place. Blocks not listed are free.
set BLOCK_MATERIAL {
    =planks :timber =palisade :timber =scaffold :timber
    =log_palisade :timber =log_palisade_top :timber
    =thatch :provisions
    =flagstone :stone =dressed_stone :stone =gravel_path :stone
}

# Harvesting: source block -> resource, units per block, work seconds
set HARVEST {
    =timber_log {=kind :timber =units 2 =seconds 1.4 =anim :chop}
    =boulder {=kind :stone =units 2 =seconds 1.8 =anim :quarry}
    =berry_bush {=kind :provisions =units 3 =seconds 1.0 =anim :forage}
}
set HARVEST_BLOCKS {=timber [:timber_log] =stone [:boulder] =provisions [:berry_bush]}

set SEARCH_RADIUS 72
# The generator never sets a leaf further than this from its trunk
set LEAF_REACH 2
set CROWN_DEPTH 12
set BUSH_REGROW_SECONDS 90.0

# Hunger: full at 1.0, falls to 0 over this many seconds
set HUNGER_SECONDS 360.0
set HUNGER_EAT_AT 0.35
# A meal heals. A Hand gets this much of its health back at once, and eats sooner when it's below
# HURT_EATS_AT of it. A soldier is brought one, once it's below MEAL_AT and has been out of the fight
# for MEAL_CALM_SECONDS, and gets MEAL_HEAL back over MEAL_SECONDS.
set HAND_MEAL_HEAL 0.4
set HURT_EATS_AT 0.7
set HURT_HUNGER 0.8
set MEAL_AT 0.75
set MEAL_CALM_SECONDS 8.0
set MEAL_HEAL 0.4
set MEAL_SECONDS 20.0
# Below this in the yard, gathering food comes first and none of it goes to building sites
set FOOD_RESERVE 20

set HAND_COST {=provisions 5}
set HAND_TRAIN_SECONDS 10.0

# Laid into the ground rather than set on top of it
set SURFACE_BLOCKS [:gravel_path :flagstone]
set LAY_MAX_CELLS 32
# One section of wall, from the ground up
set FENCE_BLOCKS [:log_palisade :log_palisade :log_palisade_top]

set BUILDINGS {
    =shelter {=blueprint :shelter =housing 4}
    =forager_hut {=blueprint :forager_hut =gather_bonus :provisions}
    =sawpit {=blueprint :sawpit =gather_bonus :timber}
    =watchtower {=blueprint :watchtower =vision 44.0 =eye_height 11.0}
    =palisade_wall {=blueprint :palisade_wall}
}

set BASE_HOUSING 8

# ---- Pressures (scripts/pressures.fsc) ----------------------------------------
# A soldier eats one food from the yard this often, and when there's none tries again after the next
set RATION_SECONDS 120
set RATION_RETRY_SECONDS 10
# Hungry, a soldier loses this much heart a second, and soon breaks
set MORALE_LOSS_HUNGRY 0.04
# A grove this far out from a settlement towards the middle of the map, this wide either way
set GROVE_OUT 50
set GROVE_RADIUS 7
set GROVE_BUSHES 18
set GROVE_BOULDERS 6
# Brigands: the side's id, when the first band comes and how long between, and how long a band stays.
# A band is BRIGAND_BASE strong, one more each BRIGAND_GROWTH_MINUTES of the game, up to BRIGAND_MAX.
set BRIGAND_ID 15
set BRIGAND_FIRST_SECONDS 420
set BRIGAND_EVERY_SECONDS 270
set BRIGAND_STAY_SECONDS 120
set BRIGAND_BASE 2
set BRIGAND_GROWTH_MINUTES 5
set BRIGAND_MAX 8
set BRIGAND_COLOR [0.45 0.36 0.28]

# A building does its job while this much of it stands. Hands mend anything less than whole.
set BUILDING_WORKS_AT 0.75

# How many spots a commander looks at before leaving a building for its next plan
set AI_PLACE_TRIES 12

# Ground cleared around a settlement, either side of its centre and above and below its level
set LEVEL_RADIUS 14
set LEVEL_HEIGHT 24

# Hands run from raiders this close, for home
set FLEE_RADIUS 9
set FLEE_CHECK_SECONDS 1.0
# How far a Hand runs, when home's no safer
set FLEE_DISTANCE 20
# Clear of them, a Hand runs on this long. Everyone then keeps this far from where they were seen,
# for this long after they last were.
set FLEE_CALM_SECONDS 5
set DANGER_RADIUS 14
set DANGER_SECONDS 30
set GATHER_BONUS_RADIUS 32
set GATHER_BONUS_SPEED 0.7

# Thinks per second is 30 / THINK_INTERVAL
set THINK_INTERVAL 8
set THINK_SECONDS (THINK_INTERVAL / 30.0)

# ---- Units ------------------------------------------------------------------
# kind: melee or ranged. range is reach for melee, draw length for ranged.
set UNITS {
    =militia {=role :melee =damage 8.0 =range 2.2 =cooldown 1.0 =aggro 16 =strike_anim :thrust
              =cost {=timber 4 =provisions 8}}
    =shortbow {=role :ranged =damage 6.0 =range 18.0 =cooldown 1.7 =aggro 20 =strike_anim :shoot
               =cost {=timber 8 =provisions 6}}
    =scout {=role :scout =damage 0.0 =range 0.0 =cooldown 1.0 =aggro 0 =strike_anim :work
            =cost {=provisions 8}}
}
set TRAIN_SECONDS 8.0
# The most one order can queue
set QUEUE_BATCH 8
# One swing of a strike's animation
set STRIKE_SECONDS 0.8
# Slow enough that an arrow climbs and drops on its way, as one from a bow does: at 18 blocks it
# leaves at about 20 degrees. Gravity is the engine's 14, so nothing past 28 blocks can be reached.
set ARROW_SPEED 20.0
set CHASE_REPATH_DISTANCE_SQ 16
# Failed searches in a row before a soldier stops hunting someone it was sent after
set HUNT_TRIES 3
# How long out of sight before it's lost, and the soldier makes for where it was last seen
set HUNT_BLIND_SECONDS 1.5
set CHASE_GIVE_UP_SECONDS 7.0
# How long before a unit will run after what it gave up on. It'll still hit it in reach.
set CHASE_FORGET_SECONDS 20.0

# A soldier guards the spot it was last sent to, and goes this far from it after an enemy
set POST_LEASH 24
# A soldier on guard takes on an enemy that comes this near its post or itself, and leaves one further
# off alone unless it's in reach or hitting it
set GUARD_ENGAGE 10
# Of enemies no more than this further off than the nearest, a soldier goes for the most hurt
set FOCUS_SLACK 3.0
# How long a blow counts as just now. Longer than a bow takes to draw.
set STRUCK_SECONDS 2.5

# Someone under attack calls for help: how often, how far around them counts the enemies and
# friends there, how far off a soldier can hear, and how many soldiers go for each armed enemy
set ALARM_SECONDS 1.0
set ALARM_RADIUS 14
set ALARM_REACH 40
set ALARM_ANSWER 2

# A Pathfinder left to itself: how fine a grid of the map it looks over for ground nobody's seen,
# how far in from the edge that stops, and how long it waits for news once it's all been seen
set EXPLORE_GRID 16
set EXPLORE_MARGIN 8
set EXPLORE_RECHECK_SECONDS 10.0
# Squared distances: this near and it should be able to see it, and this little ground gained
set EXPLORE_NEAR_SQ 400
set EXPLORE_STUCK_SQ 16

# Actual height wins fights (DESIGN 6.2)
set HIGH_GROUND_RANGE_PER_BLOCKS 2.0
set HIGH_GROUND_DAMAGE 1.15

# Morale: 1.0 is steady. Units rout below ROUT_AT and rally above RALLY_AT.
set ROUT_AT 0.25
set RALLY_AT 0.6
set MORALE_LOSS_HIT 0.06
set MORALE_LOSS_ALLY_DOWN 0.12
set MORALE_LOSS_OUTNUMBERED 0.05
set MORALE_GAIN_NEAR_HOME 0.12
set MORALE_GAIN_RESTING 0.03

# Conquest: soldier-seconds at the Keystone, unopposed, to break it
set KEYSTONE_CAPTURE_POINTS 40
# Reaches the Hall's walls and doorway: being inside the Hall is what counts
set KEYSTONE_RADIUS 7
# How near a soldier gets to swing at it, how long it waits if it can't get that near, and how high
# over it the bar goes, clear of the Hall's roof
set KEYSTONE_REACH 2.5
set KEYSTONE_RETRY_SECONDS 5.0
set KEYSTONE_BAR_HEIGHT 9

# Soldiers who fight hand to hand break buildings a block at a time: blows for a block of each
# material, how far from its chest one reaches, and so how many blocks up off the ground it can get
# at. A building it can't reach any more of, it leaves alone for a while.
set WRECK_BLOWS {=timber 3 =provisions 2 =stone 6}
set WRECK_BLOWS_OTHER 4
set WRECK_REACH 3.0
set WRECK_HEIGHT 3
set WRECK_TRIES 3
set WRECK_RETRY_SECONDS 10.0
