# Civilizations: their state and setup.

set factions [nil]

# Colours a player can tell apart at a glance, in the order factions take them. The first two are
# what they've always been.
set FACTION_COLORS [
    [0.08 0.26 1.0] [0.95 0.1 0.08] [0.1 0.75 0.2] [0.95 0.75 0.1]
    [0.65 0.2 0.9] [0.95 0.45 0.05] [0.1 0.8 0.85] [0.95 0.4 0.7]
]

fn make_faction [id x z] do
    let spot {find_settlement_site x z}
    let f {=id id =x spot[0] =y spot[1] =z spot[2]
           =hands [] =buildings [] =sites [] =zone nil
           =keystone nil =alive true =housing BASE_HOUSING
           =train_queue 0 =train_timer 0.0 =regrow [] =scaffold []
           =army [] =muster [] =muster_timer 0.0 =capture 0
           =commander nil =keystone_seen_by nil =tidy_site nil =hall nil =canopy_repaired true
           =owner nil}
    while (factions.length <= id) do
        factions.push nil
    end
    factions.set id f
    return f
end

# The faction whose orders this player gives. Nobody in particular means the first: that's a
# scenario, or a tool, with no seat to speak of.
fn faction_of [player] do
    let id {player_faction player}
    if (id == nil) { return factions[1] }
    return factions[id]
end

fn alive_factions [] do
    let out []
    for f in factions do
        if ((f != nil) and f.alive) { out.push f }
    end
    return out
end

# A ring, so that everyone starts as far from each other as the map allows. Two sides face each
# other across the middle.
fn settlement_spot [index count] do
    let r (WORLD_RADIUS * 8)
    let turn (3.14159265 + ((6.2831853 * index) / count))
    return [{round (r * {cos turn})} {round (r * {sin turn})}]
end

fn endow_new [f] do
    found_settlement f
    endow f 60 30 60
    for i in (0..8) do
        spawn_hand f
    end
end

fn steward_home [f] do
    return {spawn_point f.x (f.z + 6) 6 f.y}
end

# A commander's faction goes to a player, who takes over where it left off. It's the only fair way
# into a game that's been going for a while.
fn seat_player [player] do
    for f in factions do
        if ((f != nil) and f.alive and (f.commander != nil)) do
            set f.commander nil
            set f.owner player.id
            player_bind player.id f.id =at {steward_home f}
            log player.name "takes over faction" f.id
            return f
        end
    end

    # Nobody to replace, so a new settlement on the ring, wherever it's clearest
    let id factions.length
    let spot {settlement_spot id (id + 1)}
    let f {make_faction id spot[0] spot[1]}
    vision_add_faction id
    endow_new f
    set f.owner player.id
    player_bind player.id id =at {steward_home f}
    log player.name "founds faction" id
    return f
end

fn grant_stock [f kind amount] do
    zone_deposit f.zone kind amount f.x f.z
end

# The Hall is never built, so it's not among f.buildings, but it's as much a building to look at
fn note_hall [f hall_x y hall_z] do
    let info {blueprint_info :core_hall}
    set f.hall {=name :core_hall =site nil =x (hall_x + {floor (info.size_x / 2)}) =y y
                =z (hall_z + {floor (info.size_z / 2)}) =size_x info.size_x =size_z info.size_z
                =complete true =faction f.id}
end

# Levelling cuts straight through trees at its edge, which would leave the far side of a crown
fn prune_settlement [f] do
    let reach (LEVEL_RADIUS + LEAF_REACH)
    prune_canopy (f.x - reach) (f.y - LEVEL_HEIGHT) (f.z - reach) (f.x + reach) (f.y + LEVEL_HEIGHT) (f.z + reach)
end

fn found_settlement [f] do
    let y f.y
    level_area (f.x - LEVEL_RADIUS) (f.z - LEVEL_RADIUS) (f.x + LEVEL_RADIUS) (f.z + LEVEL_RADIUS) y
    prune_settlement f

    # Core Hall stands finished from the start
    let hall_x (f.x - 4)
    let hall_z (f.z - 4)
    let site {site_create :core_hall hall_x y hall_z}
    let cells {site_remaining site}
    build_instantly site
    site_remove site
    set f.keystone [(hall_x + 4) (y + 1) (hall_z + 4)]
    note_hall f hall_x y hall_z

    set f.zone {make_zone f.id (f.x + 7) y (f.z - 6) 7 12}
end

# Hands' stock is physical, so the starting endowment is real blocks in the yard
fn endow [f timber stone provisions] do
    grant_stock f :timber timber
    grant_stock f :stone stone
    grant_stock f :provisions provisions
end

fn spawn_hand [f] do
    let at {spawn_point f.x (f.z + 6) 6 f.y}
    let id {ent_spawn :hand at =faction f.id}
    let w {make_worker f id}
    f.hands.push w
    index_unit id f w
    return w
end

# Commands arrive as entity ids
set unit_index {map}

fn index_unit [id f record] do
    unit_index.set {to_sym id} {=faction f.id =record record}
end

fn lookup_unit [id] { return {unit_index.get {to_sym id}} }
