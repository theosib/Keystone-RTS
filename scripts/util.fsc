# Small helpers shared by the game scripts.

fn block_at [x y z] {world_get_block x y z}

# Terrain doesn't include plants and loose rock

set SOFT_BLOCKS [:canopy :timber_log :berry_bush :berry_bush_bare :boulder]

fn not_soft [b] do
    if (b == :air) { return false }
    return (not {SOFT_BLOCKS.contains b})
end

# Top solid terrain block in a column, ignoring what grows on it
fn ground_y [x z] do
    let y {surface_y x z}
    if (y == nil) { return nil }
    while (y > 0) do
        if {not_soft {block_at x y z}} { return y }
        set y (y - 1)
    end
    return nil
end

# What the world is made of. To ground_y a roof is ground too, so anything setting a
# unit down has to ask about the block as well as its height
set TERRAIN_BLOCKS [:turf :loam :stone :sand :gravel]

fn open_ground [x z] do
    let y {ground_y x z}
    if ((y == nil) or (y <= SEA_LEVEL)) { return nil }
    if (not {TERRAIN_BLOCKS.contains {block_at x y z}}) { return nil }
    if (({block_at x (y + 1) z} != :air) or ({block_at x (y + 2) z} != :air)) { return nil }
    return y
end

# Somewhere a body fits: something firm underfoot and room for it to stand up
fn can_stand [x y z] do
    if (not {not_soft {block_at x (y - 1) z}}) { return false }
    return (({block_at x y z} == :air) and ({block_at x (y + 1) z} == :air))
end

# The height nearest y in this column that a body can stand at, a few blocks either way, for ground
# that slopes. A roof is ground to ground_y, but not to this: the floor under it is nearer.
fn stand_y [x z y] do
    for d in [0 1 -1 2 -2 3 -3] do
        if {can_stand x (y + d) z} { return (y + d) }
    end
    return nil
end

# Open ground with a cell of room all round. A soldier's spear and shield reach well past its
# body, so a cell that only just fits it leaves them poking through the wall next door.
fn clear_ground [x z] do
    let y {open_ground x z}
    if (y == nil) { return nil }
    for dx in (-1..=1) do
        for dz in (-1..=1) do
            for up in [1 2] do
                if ({block_at (x + dx) (y + up) (z + dz)} != :air) { return nil }
            end
        end
    end
    return y
end

# Where to set a unit down near (cx, cz): open ground, widening out past whatever has
# been built there. Each ring gets a few tries so units don't all land on one spot.
fn spawn_point [cx cz radius fallback_y] do
    let r radius
    while (r <= (radius + 32)) do
        for i in (0..16) do
            let angle ({random_float} * 6.28)
            let x {floor (cx + (r * {cos angle}))}
            let z {floor (cz + (r * {sin angle}))}
            let y {clear_ground x z}
            if (y != nil) { return [(x + 0.5) (y + 1) (z + 0.5)] }
        end
        set r (r + 4)
    end
    return [cx (fallback_y + 1) cz]
end

# A symbol's name, without the colon that to_str and interpolation keep
fn sym_name [s] do
    let text {to_str s}
    if ({str_substr text 0 1} == ":") { return {str_substr text 1 ({str_length text} - 1)} }
    return text
end

fn dist2 [ax az bx bz] do
    let dx (ax - bx)
    let dz (az - bz)
    return ((dx * dx) + (dz * dz))
end

fn min_int [a b] do
    if (a < b) { return a }
    return b
end

fn max_int [a b] do
    if (a > b) { return a }
    return b
end

# Flatten a rectangle so its top solid layer sits at y-1, clearing what's above
fn level_area [x0 z0 x1 z1 y] do
    for x in (x0..=x1) do
        for z in (z0..=z1) do
            let h y
            while (h < (y + LEVEL_HEIGHT)) do
                world_set_block x h z :air
                set h (h + 1)
            end
            set h (y - 1)
            while (h > (y - 8)) do
                let here {block_at x h z}
                if ({not_soft here} and (h < (y - 1))) { break }
                let fill :loam
                if (h == (y - 1)) { set fill :turf }
                world_set_block x h z fill
                set h (h - 1)
            end
        end
    end
end

# A spot near (x, z) with room, above water. Scans outward in steps.
fn find_settlement_site [x z] do
    let best nil
    let radius 0
    while (radius <= 64) do
        for dx in [(0 - radius) 0 radius] do
            for dz in [(0 - radius) 0 radius] do
                let y {ground_y (x + dx) (z + dz)}
                if ((y != nil) and (y > (SEA_LEVEL + 1))) {
                    return [(x + dx) (y + 1) (z + dz)]
                }
            end
        end
        set radius (radius + 8)
    end
    return [x 80 z]
end
