# Match flow: Keystone capture, victory, and carrying on (DESIGN 5.1, 7).

set contest {=state :playing =winner nil =conquered nil}

# Whether a faction's own vision has found a rival's Keystone
fn note_keystone_sightings [] do
    for f in factions do
        if (f != nil) do
            for other in factions do
                if ((other != nil) and (other.id != f.id) and (other.keystone != nil)) do
                    if {vision_can_see f.id other.keystone[0] other.keystone[2]} {
                        set other.keystone_seen_by f.id
                    }
                end
            end
        end
    end
end

fn tick_capture [f] do
    if (f.keystone == nil) { return nil }
    let attackers {count_armed f.keystone KEYSTONE_RADIUS f.id true}
    let defenders {count_armed f.keystone KEYSTONE_RADIUS f.id false}

    if ((attackers > 0) and (defenders == 0)) do
        set f.capture (f.capture + attackers)
    elif (f.capture > 0) do
        set f.capture (f.capture - 1)
    end

    if (f.capture >= KEYSTONE_CAPTURE_POINTS) { conquer f }
end

fn keystone_percent [f] { return {min {floor ((f.capture * 100) / KEYSTONE_CAPTURE_POINTS)} 100} }

# Keystones being broken that this side can see, its own wherever it's looking from
fn keystones_going [viewer] do
    let out []
    for f in factions do
        if ((f != nil) and (f.keystone != nil) and (f.capture > 0)) do
            let k f.keystone
            let mine (f.id == viewer.id)
            if (mine or {vision_can_see viewer.id k[0] k[2]}) {
                out.push {=x k[0] =y (k[1] + KEYSTONE_BAR_HEIGHT) =z k[2] =percent {keystone_percent f} =mine mine}
            }
        end
    end
    return out
end

fn conquer [f] do
    set f.alive false
    world_set_block f.keystone[0] f.keystone[1] f.keystone[2] :air
    set f.keystone nil
    log "faction" f.id "has fallen"

    # Losing the Keystone breaks a civilization's nerve
    for s in f.army do
        set s.morale 0.0
    end

    let survivors 0
    let winner nil
    for other in factions do
        if ((other != nil) and other.alive) do
            set survivors (survivors + 1)
            set winner other.id
        end
    end
    if (survivors <= 1) do
        set contest.state :over
        set contest.winner winner
        log "match over, winner" winner
    end
end

fn tick_match [] do
    note_keystone_sightings
    if (contest.state != :playing) { return nil }
    for f in factions do
        if ((f != nil) and f.alive) { tick_capture f }
    end
end

# DESIGN 7.2: the world is always yours to keep
fn continue_open_ended [pacify] do
    set contest.state :open_ended
    reveal_all true
    if pacify do
        for f in factions do
            if ((f != nil) and (f.commander != nil)) { commander_pacify f.commander }
        end
    end
end
