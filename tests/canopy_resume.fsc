# Scenario: a save with leaves already hanging heals on load, and takes nothing else with them.
# CANOPY is a count of every leaf near home, compared across the save by tests/run_all.sh.

fn count_canopy [f] do
    let count 0
    for x in ((f.x - 60)..=(f.x + 60)) do
        for z in ((f.z - 60)..=(f.z + 60)) do
            for y in ((f.y - 12)..=(f.y + 24)) do
                if ({block_at x y z} == :canopy) { set count (count + 1) }
            end
        end
    end
    return count
end

on :tick do
    let f factions[1]
    let at (LEVEL_RADIUS + 1)
    # Past the resumed game's first ticks: tick 100 onward is only ever a resumed run
    if ({game_tick} == 60) do
        log "CANOPY" {count_canopy f}
        # As a save from before the repair would be
        set f.canopy_repaired false
        world_set_block (f.x + at) (f.y + 20) f.z :canopy
        world_set_block (f.x + at) (f.y + 21) f.z :canopy
    end
    if ({game_tick} == 110) do
        if ({block_at (f.x + at) (f.y + 20) f.z} == :canopy) do
            log "FAIL: stranded leaves survived the load"
            game_exit 1
        end
        log "CANOPY" {count_canopy f}
    end
end
