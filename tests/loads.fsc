# Scenario: wood that's wanted goes to where it's wanted. With sites short of timber and nobody
# mustering, the yard should stay close to empty, not fill while the sites wait, and the first
# in line should get done first.

# A later game_exit 0 in the same tick would win, so the last word has to know
set failed false

fn fail [why] do
    log "FAIL:" why
    set failed true
    game_exit 1
end

set worst 0
set held_seen 0

# A site whose layer being built wants timber
fn short_of_timber [f] do
    for b in f.sites do
        let left {site_remaining b.site =now true}
        for block in left.keys do
            if ({BLOCK_MATERIAL.get block} == :timber) { return true }
        end
    end
    return false
end

on :tick do
    let tick {game_tick}
    let f factions[1]

    # Nobody to run from: Hands fleeing a raid near the end take their loads to the yard, as they
    # should, and this measured that instead of where loads go
    if (tick == 1) do
        let rival factions[2]
        set rival.commander nil
    end

    if (tick == 40) do
        zone_take f.zone :timber 60 f.x f.z
        let cx (f.x - 22)
        for i in (0..5) do
            if ({place_building f :shelter (cx + (i * 7)) (f.z + 20) 0} == nil) { fail "no room for a shelter" }
        end
    end

    # Each Hand shows the load it has, as a block of what it is, from the think that changed it
    if ((tick > 10) and ((tick % 15) == 0)) do
        for w in f.hands do
            let want nil
            if (w.carry_n > 0) { set want {CARRY_BLOCKS.get w.carry_kind} }
            let shown {ent_held w.id}
            if (shown != want) { fail "a Hand with {w.carry_n} {w.carry_kind} shows {shown}" }
            if (shown != nil) { set held_seen (held_seen + 1) }
        end
    end

    if ((tick > 900) and ((tick % 30) == 0) and {short_of_timber f}) {
        set worst {max worst {stock_of f :timber}}
    }

    if (tick == 5400) do
        print "LOADS worst yard {worst}, sites left {f.sites.length}, loads seen held {held_seen}"
        if (worst > 12) { fail "{worst} timber sat in the yard with sites short of it" }
        # Five half-built sites house nobody, so the first in line comes first
        if (f.buildings.length == 0) { fail "nothing finished: the work spread over every site" }
        if (held_seen == 0) { fail "no Hand was ever seen holding its load" }
        log "LOADS DONE"
        if (not failed) { game_exit 0 }
    end
end
